<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lims.Desktop.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="using:Lims.DesignSystem.Controls"
    Background="{ThemeResource LimsBackgroundBrush}">
    <Page.Resources>
        <Style x:Key="ShellNavigationGroupStyle" TargetType="NavigationViewItemHeader">
            <Setter Property="IsHitTestVisible" Value="True" />
            <Setter Property="IsEnabled" Value="True" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource LimsTextSecondaryBrush}" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="NavigationViewItemHeader">
                        <Grid MinHeight="40" Background="Transparent">
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="16,0,4,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ShellNavigationGroupToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource LimsTextSecondaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Width" Value="240" />
            <Setter Property="Padding" Value="0,0,8,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="GroupSurface" Background="Transparent" CornerRadius="6" MinHeight="36" Padding="8,0" Control.IsTemplateFocusTarget="True">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="GroupSurface.Background" Value="{ThemeResource LimsSurfaceSecondaryBrush}" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="GroupSurface.Background" Value="{ThemeResource LimsSurfaceElevatedBrush}" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="GroupSurface.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates"><VisualState x:Name="Checked" /><VisualState x:Name="Unchecked" /><VisualState x:Name="Indeterminate" /></VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <NavigationView
        x:Name="MainNavigation"
        Background="{ThemeResource LimsBackgroundBrush}"
        AlwaysShowHeader="True"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        FontSize="13"
        OpenPaneLength="276"
        IsPaneOpen="False"
        PaneDisplayMode="Left"
        PaneOpening="OnPaneOpening"
        PaneClosing="OnPaneClosing"
        Loaded="OnNavigationLoaded"
        ItemInvoked="OnNavigationItemInvoked"
        SelectionChanged="OnSelectionChanged">
        <NavigationView.PaneHeader>
            <StackPanel x:Name="BrandLabels" Margin="4,12,4,10" Spacing="3">
                <TextBlock Style="{StaticResource LimsProductTitleStyle}" Text="LIMS" />
                <TextBlock x:Name="WorkspaceName" Style="{StaticResource LimsCaptionStyle}" Text="Suministros" />
            </StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="HomeItem" design:LimsIcon.NavigationIcon="Home" Content="Inicio" Tag="home" AutomationProperties.Name="Inicio" ToolTipService.ToolTip="Inicio"></NavigationViewItem>
            <NavigationViewItemHeader x:Name="MaterialsGroup" Style="{StaticResource ShellNavigationGroupStyle}">
                <ToggleButton x:Name="SuppliesToggle" Style="{StaticResource ShellNavigationGroupToggleStyle}" IsChecked="True" Checked="OnNavigationGroupToggled" Unchecked="OnNavigationGroupToggled" AutomationProperties.Name="Suministros" AutomationProperties.AutomationId="NavigationSuppliesGroup" AutomationProperties.HelpText="Mostrar u ocultar los módulos de Suministros">
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="SUMINISTROS" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <design:LimsIcon x:Name="SuppliesChevron" Grid.Column="1" Icon="ChevronDown" Size="12" />
                    </Grid>
                </ToggleButton>
            </NavigationViewItemHeader>
            <NavigationViewItem x:Name="StandardsItem" design:LimsIcon.NavigationIcon="Standards" Content="Estándares" AutomationProperties.Name="Estándares" ToolTipService.ToolTip="Estándares" IsEnabled="{x:Bind ViewModel.CanViewReferenceMaterials, Mode=OneWay}" Tag="standards"></NavigationViewItem>
            <NavigationViewItem x:Name="PreparationsItem" design:LimsIcon.NavigationIcon="Preparations" Content="Preparaciones" AutomationProperties.Name="Preparaciones" ToolTipService.ToolTip="Preparaciones" IsEnabled="{x:Bind ViewModel.CanViewReferenceMaterials, Mode=OneWay}" Tag="preparations" />
            <NavigationViewItem x:Name="AlertsItem" design:LimsIcon.NavigationIcon="Alerts" Content="Alertas" Tag="alerts" AutomationProperties.Name="Alertas" ToolTipService.ToolTip="Alertas y Notificaciones" Visibility="Collapsed" />
            <NavigationViewItemHeader x:Name="PlanningGroup" Style="{StaticResource ShellNavigationGroupStyle}" Visibility="Collapsed">
                <ToggleButton x:Name="PlanningToggle" Style="{StaticResource ShellNavigationGroupToggleStyle}" IsChecked="True" Checked="OnNavigationGroupToggled" Unchecked="OnNavigationGroupToggled" AutomationProperties.Name="Planificación" AutomationProperties.AutomationId="NavigationPlanningGroup" AutomationProperties.HelpText="Mostrar u ocultar los módulos de Planificación">
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="PLANIFICACIÓN" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <design:LimsIcon x:Name="PlanningChevron" Grid.Column="1" Icon="ChevronDown" Size="12" />
                    </Grid>
                </ToggleButton>
            </NavigationViewItemHeader>
            <NavigationViewItemHeader x:Name="AdministrationGroup" Style="{StaticResource ShellNavigationGroupStyle}" Visibility="Collapsed">
                <ToggleButton x:Name="AdministrationToggle" Style="{StaticResource ShellNavigationGroupToggleStyle}" IsChecked="True" Checked="OnNavigationGroupToggled" Unchecked="OnNavigationGroupToggled" AutomationProperties.Name="Administración" AutomationProperties.AutomationId="NavigationAdministrationGroup" AutomationProperties.HelpText="Mostrar u ocultar los módulos de Administración">
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="ADMINISTRACIÓN" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <design:LimsIcon x:Name="AdministrationChevron" Grid.Column="1" Icon="ChevronDown" Size="12" />
                    </Grid>
                </ToggleButton>
            </NavigationViewItemHeader>
            <NavigationViewItem x:Name="PermissionsItem" design:LimsIcon.NavigationIcon="Administration" Content="Gestión de permisos" Tag="permissions" AutomationProperties.Name="Gestión de permisos" ToolTipService.ToolTip="Gestión de permisos" Visibility="Collapsed" />
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <Grid x:Name="UserArea" Margin="4,8,4,12" Padding="0,10,0,0" BorderBrush="{ThemeResource LimsBorderBrush}" BorderThickness="0,1,0,0" ColumnSpacing="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button x:Name="UserAvatar" Width="32" Height="32" MinHeight="32" Padding="0" HorizontalAlignment="Center"
                    Style="{StaticResource LimsSecondaryButtonStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.DisplayName, Mode=OneWay}" AutomationProperties.Name="Menú de usuario">
                    <Button.Flyout><MenuFlyout><MenuFlyoutItem design:LimsIcon.NavigationIcon="SignOut" AutomationProperties.Name="Cerrar sesión" Text="Cerrar sesión" Command="{x:Bind ViewModel.LogoutCommand}" /></MenuFlyout></Button.Flyout>
                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="{x:Bind ViewModel.Initials, Mode=OneWay}" />
                </Button>
                <StackPanel x:Name="UserLabels" Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.DisplayName, Mode=OneWay}" />
                    <TextBlock FontSize="11" Foreground="{ThemeResource LimsTextSecondaryBrush}" Text="{x:Bind ViewModel.Role, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button x:Name="LogoutButton" Grid.Column="2" Style="{StaticResource LimsIconButtonStyle}" AutomationProperties.Name="Cerrar sesión" Command="{x:Bind ViewModel.LogoutCommand}" ToolTipService.ToolTip="Cerrar sesión">
                    <design:LimsIcon Icon="SignOut" Size="{StaticResource IconSizeMedium}" />
                </Button>
            </Grid>
        </NavigationView.PaneFooter>
        <NavigationView.Header>
            <Grid Margin="0,0,24,0" ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="SectionTitle" FontSize="22" FontWeight="SemiBold" Text="Inicio" />
                    <TextBlock x:Name="SectionSubtitle" Style="{StaticResource LimsCaptionStyle}" Text="Panel principal" />
                </StackPanel>
                <Button
                    x:Name="StandardsNewButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Click="OnNewStandardClick"
                    Style="{StaticResource LimsPrimaryButtonStyle}"
                    AutomationProperties.Name="Nuevo estándar"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <design:LimsIcon Icon="NewStandard" Size="{StaticResource IconSizeSmall}" Foreground="{ThemeResource LimsOnAccentBrush}" />
                        <TextBlock Text="Nuevo estándar" />
                    </StackPanel>
                </Button>
                <Button x:Name="PreparationsNewButton" Grid.Column="1" VerticalAlignment="Center"
                    Click="OnNewPreparationClick" Style="{StaticResource LimsPrimaryButtonStyle}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <design:LimsIcon Icon="NewStandard" Size="{StaticResource IconSizeSmall}" Foreground="{ThemeResource LimsOnAccentBrush}" />
                        <TextBlock x:Name="PreparationsNewLabel" Text="Nuevo Stock" />
                    </StackPanel>
                </Button>
            </Grid>
        </NavigationView.Header>
        <Grid x:Name="Workspace" Background="{ThemeResource LimsBackgroundBrush}" Padding="24,8,24,24" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <InfoBar IsOpen="{x:Bind ViewModel.HasAccessWarning, Mode=OneWay}" IsClosable="False" Severity="Warning" Message="{x:Bind ViewModel.SessionMessage, Mode=OneWay}">
                <InfoBar.ActionButton><Button Content="Reintentar" Click="OnRetryAccessClick" /></InfoBar.ActionButton>
            </InfoBar>
            <TextBlock Grid.Row="1" x:Name="DeniedPanel" Text="Acceso denegado. No tiene permiso para consultar esta pantalla." Style="{StaticResource LimsBodyStyle}" Visibility="Collapsed" />
            <ContentControl Grid.Row="1" x:Name="PermissionsHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
            <ContentControl Grid.Row="1" x:Name="AlertsHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
            <ContentControl Grid.Row="1" x:Name="HomePanel" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            <ContentControl
                Grid.Row="1" x:Name="PreparationsHost"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="Collapsed" />
            <ContentControl
                Grid.Row="1" x:Name="StandardsHost"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="Collapsed" />
        </Grid>
    </NavigationView>
</Page>
