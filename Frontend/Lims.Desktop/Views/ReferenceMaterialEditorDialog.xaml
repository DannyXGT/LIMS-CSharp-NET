<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Lims.Desktop.Views.ReferenceMaterialEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Cancelar"
    Closing="OnClosing"
    DefaultButton="Primary"
    PrimaryButtonText="Guardar"
    Title="Nuevo estándar">
    <ScrollViewer MaxHeight="610" HorizontalScrollBarVisibility="Disabled">
        <Grid MinWidth="650" Padding="0,4,8,8" ColumnSpacing="16" RowSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Grid.ColumnSpan="2" Spacing="3"><TextBox x:Name="NameBox" Header="Nombre del estándar *" MaxLength="200" /><TextBlock x:Name="NameError" Foreground="{ThemeResource LimsErrorTextBrush}" Visibility="Collapsed" /></StackPanel>
            <StackPanel Grid.Row="1" Spacing="3"><TextBox x:Name="CasBox" Header="CAS" MaxLength="80" PlaceholderText="Ej. 64-17-5" /><TextBlock x:Name="CasError" Foreground="{ThemeResource LimsErrorTextBrush}" Visibility="Collapsed" /></StackPanel>
            <TextBox x:Name="CatalogBox" Grid.Row="1" Grid.Column="1" Header="Número de catálogo" MaxLength="80" />
            <StackPanel Grid.Row="2" Spacing="3"><TextBox x:Name="MethodBox" Header="Método *" MaxLength="120" /><TextBlock x:Name="MethodError" Foreground="{ThemeResource LimsErrorTextBrush}" Visibility="Collapsed" /></StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="3"><NumberBox x:Name="PurityBox" Header="Pureza (%) *" Minimum="0.0001" Maximum="100" SmallChange="0.01" SpinButtonPlacementMode="Compact" Value="100" /><TextBlock x:Name="PurityError" Foreground="{ThemeResource LimsErrorTextBrush}" Visibility="Collapsed" /></StackPanel>
            <StackPanel Grid.Row="3" Spacing="3"><TextBox x:Name="LotBox" Header="Lote *" MaxLength="120" /><TextBlock x:Name="LotError" Foreground="{ThemeResource LimsErrorTextBrush}" Visibility="Collapsed" /></StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="1" Spacing="3"><TextBox x:Name="BrandBox" Header="Marca *" MaxLength="120" /><TextBlock x:Name="BrandError" Foreground="{ThemeResource LimsErrorTextBrush}" Visibility="Collapsed" /></StackPanel>
            <DatePicker x:Name="ReceivedDatePicker" Grid.Row="4" Header="Fecha de ingreso *" />
            <StackPanel Grid.Row="4" Grid.Column="1" Spacing="3"><DatePicker x:Name="ExpirationDatePicker" Header="Fecha de expiración *" /><TextBlock x:Name="ExpirationError" Foreground="{ThemeResource LimsErrorTextBrush}" Visibility="Collapsed" /></StackPanel>
            <StackPanel Grid.Row="5" Spacing="3"><NumberBox x:Name="PresentationBox" Header="Presentación por unidad *" Minimum="0.000001" SmallChange="0.1" SpinButtonPlacementMode="Compact" /><TextBlock x:Name="PresentationError" Foreground="{ThemeResource LimsErrorTextBrush}" Visibility="Collapsed" /></StackPanel>
            <Grid Grid.Row="5" Grid.Column="1" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ComboBox x:Name="UnitCombo" Header="Unidad *" SelectedIndex="2"><ComboBoxItem Content="µg" Tag="µg" /><ComboBoxItem Content="mg" Tag="mg" /><ComboBoxItem Content="g" Tag="g" /><ComboBoxItem Content="kg" Tag="kg" /><ComboBoxItem Content="mL" Tag="mL" /><ComboBoxItem Content="L" Tag="L" /></ComboBox><StackPanel Grid.Column="1" Spacing="3"><NumberBox x:Name="PackageCountBox" Header="Unidades *" Minimum="1" SmallChange="1" SpinButtonPlacementMode="Compact" Value="1" /><TextBlock x:Name="PackageCountError" Foreground="{ThemeResource LimsErrorTextBrush}" Visibility="Collapsed" /></StackPanel></Grid>
            <StackPanel Grid.Row="6" Spacing="3"><TextBox x:Name="StorageLocationBox" Header="Ubicación física *" MaxLength="160" Text="Laboratorio" /><TextBlock x:Name="StorageLocationError" Foreground="{ThemeResource LimsErrorTextBrush}" Visibility="Collapsed" /></StackPanel>
            <StackPanel Grid.Row="6" Grid.Column="1" Spacing="3"><TextBox x:Name="StorageConditionsBox" Header="Condiciones de almacenamiento *" MaxLength="500" PlaceholderText="Ej. 2–8 °C, protegido de la luz" /><TextBlock x:Name="StorageConditionsError" Foreground="{ThemeResource LimsErrorTextBrush}" Visibility="Collapsed" /></StackPanel>
        </Grid>
    </ScrollViewer>
</ContentDialog>
