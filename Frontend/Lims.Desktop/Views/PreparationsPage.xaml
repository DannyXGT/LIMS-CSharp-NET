<Page x:Class="Lims.Desktop.Views.PreparationsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource LimsBackgroundBrush}">
 <Grid RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="StockTab" Content="Stock" Style="{StaticResource LimsPrimaryButtonStyle}" Click="OnStock" AutomationProperties.Name="Preparaciones Stock"/><Button x:Name="IntermediateTab" Content="Intermedia" Style="{StaticResource LimsSecondaryButtonStyle}" Click="OnIntermediate" AutomationProperties.Name="Preparaciones Intermedia"/></StackPanel>
  <ContentControl x:Name="PreparationHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
 </Grid>
</Page>
