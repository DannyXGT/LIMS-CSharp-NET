<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Page composition only; corporate resources supply colors and interactions. -->
    <Style x:Key="LimsDashboardPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LimsSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource LimsBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/><Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="LimsDashboardLinkStyle" TargetType="Button" BasedOn="{StaticResource LimsStandardsSecondaryButtonStyle}">
        <Setter Property="MinHeight" Value="24"/><Setter Property="Padding" Value="4,2"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{ThemeResource LimsAccentBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="LimsDashboardRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource LimsDataRowStyle}">
        <Setter Property="MinHeight" Value="24"/><Setter Property="Padding" Value="0"/>
    </Style>
</ResourceDictionary>
