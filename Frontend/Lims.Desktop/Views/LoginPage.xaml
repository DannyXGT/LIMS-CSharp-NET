<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lims.Desktop.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="using:Lims.DesignSystem.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="#FF0A1017"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Motion -->
        <Storyboard x:Name="LoginEntrance">
            <DoubleAnimation
                Storyboard.TargetName="LoginCard"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.18" />
            <DoubleAnimation
                Storyboard.TargetName="LoginCard"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                From="8"
                To="0"
                Duration="0:0:0.18" />
        </Storyboard>

        <Storyboard x:Name="ErrorEntrance">
            <DoubleAnimation
                Storyboard.TargetName="LoginError"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.14" />
            <DoubleAnimation
                Storyboard.TargetName="LoginError"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                From="-4"
                To="0"
                Duration="0:0:0.14" />
        </Storyboard>

        <!-- Login-local visual resources. Keep auth logic untouched. -->
        <LinearGradientBrush x:Key="HeroOverlayBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D90A1017" Offset="0" />
            <GradientStop Color="#A20A1017" Offset="0.42" />
            <GradientStop Color="#5A0A1017" Offset="0.72" />
            <GradientStop Color="#A60A1017" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="RightBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF0A1017" Offset="0" />
            <GradientStop Color="#FF0C1620" Offset="0.5" />
            <GradientStop Color="#FF0B141D" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF121C26" Offset="0" />
            <GradientStop Color="#FF10202D" Offset="0.55" />
            <GradientStop Color="#FF122534" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryButtonBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF2387F1" Offset="0" />
            <GradientStop Color="#FF2A8BF2" Offset="0.55" />
            <GradientStop Color="#FF399BFF" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="LoginInputBackgroundBrush" Color="#FF0B1721" />
        <SolidColorBrush x:Key="LoginInputDividerBrush" Color="#FF2A4053" />
        <SolidColorBrush x:Key="LoginCardBorderBrush" Color="#FF30465A" />
        <SolidColorBrush x:Key="LoginPrimaryTextBrush" Color="#FFF5F7FA" />
        <SolidColorBrush x:Key="LoginSecondaryTextBrush" Color="#FFB1BDCA" />
        <SolidColorBrush x:Key="LoginMutedTextBrush" Color="#FF8394A5" />
        <SolidColorBrush x:Key="LoginAccentBrush" Color="#FF2A8BF2" />

        <!-- Remove the stock inner TextBox/PasswordBox chrome because our outer Borders own it. -->
        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>

        <Style x:Key="LoginBorderlessTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource LoginPrimaryTextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Background="Transparent">
                            <ScrollViewer x:Name="ContentElement" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Auto" VerticalAlignment="Center" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" IsTabStop="False" ZoomMode="Disabled" />
                            <TextBlock x:Name="PlaceholderTextContentPresenter" VerticalAlignment="Center" Foreground="{StaticResource LoginSecondaryTextBrush}" IsHitTestVisible="False" Text="{TemplateBinding PlaceholderText}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginBorderlessPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource LoginPrimaryTextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid Background="Transparent">
                            <ScrollViewer x:Name="ContentElement" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Auto" VerticalAlignment="Center" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" IsTabStop="False" ZoomMode="Disabled" />
                            <TextBlock x:Name="PlaceholderTextContentPresenter" VerticalAlignment="Center" Foreground="{StaticResource LoginSecondaryTextBrush}" IsHitTestVisible="False" Text="{TemplateBinding PlaceholderText}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource LoginPrimaryTextBrush}" />
        </Style>

        <Style x:Key="LoginCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource LoginMutedTextBrush}" />
        </Style>
    </Page.Resources>

    <Grid x:Name="PageLayout" Background="#FF0A1017">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="HeroColumn" Width="52*" MinWidth="390" />
            <ColumnDefinition x:Name="AuthenticationColumn" Width="48*" MinWidth="440" />
        </Grid.ColumnDefinitions>

        <!-- LEFT / BRAND + LAB -->
        <Grid x:Name="HeroPanel" Background="#FF08111A">
            <Rectangle AutomationProperties.Name="Laboratorio LIMS">
                <Rectangle.Fill>
                    <ImageBrush
                        AlignmentX="Center"
                        AlignmentY="Bottom"
                        ImageSource="ms-appx:///Assets/Branding/LoginLaboratoryBackground.png"
                        Stretch="UniformToFill">
                        <ImageBrush.RelativeTransform>
                            <CompositeTransform
                                CenterX="0.5"
                                CenterY="0.5"
                                ScaleX="1.3"
                                ScaleY="1.3"
                                TranslateX="-0.06"
                                TranslateY="-0.05" />
                        </ImageBrush.RelativeTransform>
                    </ImageBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle Fill="{StaticResource HeroOverlayBrush}" />

            <!-- subtle technical depth, without competing with the photo -->
            <Rectangle
                Width="1"
                HorizontalAlignment="Right"
                Fill="#FF30465A"
                Opacity="0.8" />

            <Grid x:Name="HeroContent" Padding="48,42,44,38">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border
                            Width="42"
                            Height="42"
                            Visibility="Collapsed"
                            Background="#E6102230"
                            BorderBrush="#A830465A"
                            BorderThickness="1"
                            CornerRadius="10">
                            <design:LimsIcon HorizontalAlignment="Center" VerticalAlignment="Center" Icon="Reports" Size="{StaticResource IconSizeMedium}" Foreground="{ThemeResource LimsAccentBrush}" />
                        </Border>

                        <StackPanel VerticalAlignment="Center" Spacing="-1">
                            <TextBlock
                                FontFamily="Segoe UI Variable Display"
                                FontSize="32"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource LoginPrimaryTextBrush}"
                                Text="intertek" />
                            <TextBlock
                                x:Name="HeroBrandTagline"
                                FontFamily="Segoe UI Variable Text"
                                FontSize="11"
                                Foreground="{StaticResource LoginSecondaryTextBrush}"
                                Text="Gestión de laboratorio" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    MaxWidth="330"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Spacing="0">
                    <Rectangle
                        Width="44"
                        Height="3"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,24"
                        Fill="{StaticResource LoginAccentBrush}"
                        RadiusX="1.5"
                        RadiusY="1.5" />

                    <TextBlock
                        x:Name="HeroHeadline"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="34"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource LoginPrimaryTextBrush}"
                        LineHeight="42"
                        Text="Gestión de&#x0a;laboratorio,&#x0a;con precisión."
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Name="HeroSupport"
                        Margin="0,24,0,0"
                        FontFamily="Segoe UI Variable Text"
                        FontSize="15"
                        Foreground="#FFD0DAE4"
                        LineHeight="23"
                        Text="Datos confiables.&#x0a;Procesos eficientes.&#x0a;Resultados con trazabilidad."
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="7">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            FontFamily="Segoe UI Variable Display"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource LoginPrimaryTextBrush}"
                            Text="LIMS" />
                        <Rectangle
                            Width="20"
                            Height="1"
                            VerticalAlignment="Center"
                            Fill="{StaticResource LoginSecondaryTextBrush}"
                            Opacity="0.65" />
                    </StackPanel>

                    <TextBlock
                        CharacterSpacing="150"
                        FontFamily="Segoe UI Variable Text"
                        FontSize="9"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource LoginSecondaryTextBrush}"
                        LineHeight="15"
                        Text="LABORATORY INFORMATION&#x0a;MANAGEMENT SYSTEM" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- RIGHT / AUTH -->
        <Grid
            x:Name="RightPanel"
            Grid.Column="1"
            Padding="16,24,16,18"
            Background="{StaticResource RightBackgroundBrush}">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch"
                VerticalScrollBarVisibility="Hidden"
                VerticalContentAlignment="Center">

                <Grid
                    MaxWidth="440"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">

                    <!-- pseudo shadow -->
                    <Border
                        Margin="0,10,0,0"
                        Background="#5C000000"
                        CornerRadius="18"
                        IsHitTestVisible="False" />

                    <Border
                        x:Name="LoginCard"
                        Margin="0,0,0,10"
                        Padding="30,24,30,24"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource LoginCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Opacity="0"
                        RenderTransformOrigin="0.5,0.5">

                        <Border.RenderTransform>
                            <CompositeTransform />
                        </Border.RenderTransform>

                        <StackPanel Spacing="0">

                            <!-- card identity -->
                            <StackPanel Spacing="10">
                                <Border
                                    Width="44"
                                    Height="44"
                                    HorizontalAlignment="Left"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="12">
                                    <Viewbox
                                        Width="31"
                                        Height="35"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Laboratorio">
                                        <Grid Width="32" Height="36">
                                            <Path
                                                Data="M10,3 L22,3 M13,3 L13,13 L5,28 C4,30 5,32 8,32 L24,32 C27,32 28,30 27,28 L19,13 L19,3"
                                                Fill="Transparent"
                                                Stroke="{StaticResource LoginAccentBrush}"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="2.4" />
                                            <Path
                                                Data="M9,24 C12,23 14,25 17,24 C20,23 22,25 24,24"
                                                Fill="Transparent"
                                                Stroke="{StaticResource LoginAccentBrush}"
                                                StrokeEndLineCap="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="2" />
                                            <Ellipse
                                                Width="3"
                                                Height="3"
                                                Margin="18,19,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Fill="{StaticResource LoginAccentBrush}" />
                                        </Grid>
                                    </Viewbox>
                                </Border>

                                <Rectangle
                                    Width="44"
                                    Height="3"
                                    HorizontalAlignment="Left"
                                    Fill="{StaticResource LoginAccentBrush}"
                                    RadiusX="1.5"
                                    RadiusY="1.5" />
                            </StackPanel>

                            <StackPanel Margin="0,18,0,0" Spacing="6">
                                <TextBlock
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="30"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource LoginPrimaryTextBrush}"
                                    Text="Bienvenido a LIMS" />

                                <TextBlock
                                    x:Name="LoginSubtitle"
                                    FontFamily="Segoe UI Variable Text"
                                    FontSize="14"
                                    Foreground="{StaticResource LoginSecondaryTextBrush}"
                                    Text="Inicia sesión para continuar." />
                            </StackPanel>

                            <Border
                                x:Name="LoginError"
                                Margin="0,7,0,0"
                                Padding="9,5"
                                Background="#4A5A2027"
                                BorderBrush="#AA9B4650"
                                BorderThickness="1"
                                CornerRadius="7"
                                Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}">
                                <Border.RenderTransform>
                                    <CompositeTransform />
                                </Border.RenderTransform>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <design:LimsIcon VerticalAlignment="Center" Icon="Error" Size="{StaticResource IconSizeSmall}" IsDanger="True" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe UI Variable Text"
                                        FontSize="12"
                                        Foreground="#FFF7E8EA"
                                        Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="LoginForm" Margin="0,22,0,0" Spacing="14">

                                <!-- USER -->
                                <StackPanel Spacing="7">
                                    <TextBlock Style="{StaticResource LoginLabelStyle}" Text="Usuario" />

                                    <Border
                                        x:Name="IdentifierContainer"
                                        Height="50"
                                        Background="{StaticResource LoginInputBackgroundBrush}"
                                        BorderBrush="{ThemeResource LimsInputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        PointerEntered="OnIdentifierPointerEntered"
                                        PointerExited="OnIdentifierPointerExited">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="1" />
                                                <ColumnDefinition Width="136" />
                                            </Grid.ColumnDefinitions>

                                            <design:LimsIcon HorizontalAlignment="Center" VerticalAlignment="Center" Icon="User" Size="{StaticResource IconSizeSmall}" Foreground="{ThemeResource LimsTextSecondaryBrush}" />

                                            <TextBox
                                                x:Name="IdentifierBox"
                                                Grid.Column="1"
                                                MinWidth="0"
                                                MaxLength="64"
                                                Margin="0,0,10,0"
                                                AutomationProperties.HelpText="Ingrese únicamente el nombre de usuario; el dominio corporativo se añade automáticamente."
                                                AutomationProperties.Name="Usuario"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="0"
                                                Foreground="{StaticResource LoginPrimaryTextBrush}"
                                                GotFocus="OnIdentifierGotFocus"
                                                LostFocus="OnIdentifierLostFocus"
                                                Padding="0"
                                                PlaceholderText="nombre.apellido"
                                                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                                SelectionHighlightColor="{ThemeResource LimsSelectionBrush}"
                                                Style="{StaticResource LoginBorderlessTextBoxStyle}"
                                                TabIndex="0"
                                                Text="{x:Bind ViewModel.Identifier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="NoWrap"
                                                UseSystemFocusVisuals="False"
                                                VerticalContentAlignment="Center" />

                                            <Rectangle
                                                Grid.Column="2"
                                                Width="1"
                                                Margin="0,10"
                                                Fill="{StaticResource LoginInputDividerBrush}" />

                                            <TextBlock
                                                Grid.Column="3"
                                                Margin="14,0"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe UI Variable Text"
                                                FontSize="13"
                                                Foreground="{StaticResource LoginSecondaryTextBrush}"
                                                Text="{x:Bind ViewModel.CorporateDomain}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- PASSWORD -->
                                <StackPanel Spacing="7">
                                    <TextBlock Style="{StaticResource LoginLabelStyle}" Text="Contraseña" />

                                    <Border
                                        x:Name="PasswordContainer"
                                        Height="50"
                                        Background="{StaticResource LoginInputBackgroundBrush}"
                                        BorderBrush="{ThemeResource LimsInputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        PointerEntered="OnPasswordPointerEntered"
                                        PointerExited="OnPasswordPointerExited">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="52" />
                                            </Grid.ColumnDefinitions>

                                            <design:LimsIcon HorizontalAlignment="Center" VerticalAlignment="Center" Icon="Lock" Size="{StaticResource IconSizeSmall}" Foreground="{ThemeResource LimsTextSecondaryBrush}" />

                                            <PasswordBox
                                                x:Name="PasswordInput"
                                                Grid.Column="1"
                                                MinWidth="0"
                                                Margin="0,0,8,0"
                                                AutomationProperties.HelpText="Use el botón mostrar contraseña para revisar el texto."
                                                AutomationProperties.Name="Contraseña"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="0"
                                                Foreground="{StaticResource LoginPrimaryTextBrush}"
                                                GotFocus="OnPasswordGotFocus"
                                                LostFocus="OnPasswordLostFocus"
                                                Padding="0"
                                                Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                PasswordRevealMode="Hidden"
                                                PlaceholderText="Ingrese su contraseña"
                                                SelectionHighlightColor="{ThemeResource LimsSelectionBrush}"
                                                Style="{StaticResource LoginBorderlessPasswordBoxStyle}"
                                                TabIndex="1"
                                                UseSystemFocusVisuals="False"
                                                VerticalContentAlignment="Center" />

                                            <Button
                                                x:Name="RevealPasswordButton"
                                                Grid.Column="2"
                                                Width="40"
                                                Height="40"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Mostrar contraseña"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                Click="OnTogglePasswordVisibility"
                                                CornerRadius="8"
                                                Foreground="{StaticResource LoginSecondaryTextBrush}"
                                                GotFocus="OnPasswordGotFocus"
                                                LostFocus="OnPasswordLostFocus"
                                                Padding="0"
                                                TabIndex="2"
                                                ToolTipService.ToolTip="Mostrar contraseña">

                                                <design:LimsIcon x:Name="RevealPasswordGlyph" Icon="ShowPassword" Size="{StaticResource IconSizeSmall}" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- CTA -->
                                <Button
                                    Height="50"
                                    AutomationProperties.Name="Iniciar sesión"
                                    Background="{StaticResource PrimaryButtonBrush}"
                                    BorderBrush="#FF58A6FF"
                                    BorderThickness="1"
                                    Command="{x:Bind ViewModel.SignInCommand}"
                                    CornerRadius="8"
                                    FontFamily="Segoe UI Variable Text"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    IsEnabled="{x:Bind ViewModel.CanSignIn, Mode=OneWay}"
                                    TabIndex="3">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>

                                        <ProgressRing
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Left"
                                            Foreground="White"
                                            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind ViewModel.ActionLabel, Mode=OneWay}" />

                                        <design:LimsIcon x:Name="SubmitArrow" Grid.Column="2" HorizontalAlignment="Right" Icon="SignIn" Size="{StaticResource IconSizeSmall}" />
                                    </Grid>
                                </Button>

                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <StackPanel
                Grid.Row="1"
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="9">

                <TextBlock
                    Style="{StaticResource LoginCaptionStyle}"
                    Text="{x:Bind ViewModel.EnvironmentLabel}" />

                <Ellipse
                    Width="3"
                    Height="3"
                    VerticalAlignment="Center"
                    Fill="{StaticResource LoginMutedTextBrush}" />

                <TextBlock
                    Style="{StaticResource LoginCaptionStyle}"
                    Text="{x:Bind ViewModel.VersionLabel}" />
            </StackPanel>
        </Grid>

        <!-- Responsive behavior: at narrow effective widths hide the decorative hero rather than crush auth controls. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeroColumn.Width" Value="0" />
                        <Setter Target="HeroColumn.MinWidth" Value="0" />
                        <Setter Target="HeroPanel.Visibility" Value="Collapsed" />
                        <Setter Target="AuthenticationColumn.Width" Value="1*" />
                        <Setter Target="RightPanel.Padding" Value="24,24,24,18" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Normal">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="780" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeroColumn.Width" Value="52*" />
                        <Setter Target="HeroColumn.MinWidth" Value="390" />
                        <Setter Target="HeroPanel.Visibility" Value="Visible" />
                        <Setter Target="AuthenticationColumn.Width" Value="48*" />
                        <Setter Target="RightPanel.Padding" Value="16,24,16,18" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
