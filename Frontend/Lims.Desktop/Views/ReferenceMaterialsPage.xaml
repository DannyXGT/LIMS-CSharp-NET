<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lims.Desktop.Views.ReferenceMaterialsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contracts="using:Lims.Contracts.ReferenceMaterials"
    Background="Transparent"
    Loaded="OnLoaded">
    <Grid RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="4"><TextBlock Style="{StaticResource LimsPageTitleStyle}" Text="Estándares" /><TextBlock Style="{StaticResource LimsBodyStyle}" Text="Materiales de Referencia" /></StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Center" Click="OnCreateClick" Content="Nuevo estándar" IsEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" />
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="180" /><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Nombre, CAS, catálogo, lote o marca" QueryIcon="Find" QuerySubmitted="OnSearchSubmitted" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox x:Name="StatusCombo" Grid.Column="1" Header="Estado" SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="Todos" Tag="" IsSelected="True" /><ComboBoxItem Content="Activo" Tag="Active" /><ComboBoxItem Content="Agotado" Tag="Depleted" /><ComboBoxItem Content="Vencido" Tag="Expired" /><ComboBoxItem Content="Bloqueado" Tag="Blocked" /><ComboBoxItem Content="Reemplazado" Tag="Replaced" /><ComboBoxItem Content="Archivado" Tag="Archived" /><ComboBoxItem Content="Retirado" Tag="Retired" />
            </ComboBox>
            <TextBox x:Name="MethodBox" Grid.Column="2" Header="Método" PlaceholderText="Todos" TextChanged="OnMethodChanged" />
            <Button Grid.Column="3" VerticalAlignment="Bottom" Click="OnApplyFiltersClick" Content="Aplicar filtros" />
            <Button Grid.Column="4" VerticalAlignment="Bottom" Click="OnClearFiltersClick" ToolTipService.ToolTip="Limpiar filtros"><FontIcon Glyph="&#xE894;" /></Button>
        </Grid>
        <InfoBar Grid.Row="2" IsClosable="False" IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}" Message="{x:Bind ViewModel.Message, Mode=OneWay}" Severity="Warning" />
        <Grid Grid.Row="3" ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="13*" MinWidth="620" /><ColumnDefinition Width="7*" MinWidth="340" /></Grid.ColumnDefinitions>
            <Border Background="{ThemeResource LimsSurfaceBrush}" BorderBrush="{ThemeResource LimsBorderBrush}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Padding="12,0" Background="{ThemeResource LimsSurfaceSecondaryBrush}" ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="150" /><ColumnDefinition Width="*" MinWidth="90" /><ColumnDefinition Width="*" MinWidth="80" /><ColumnDefinition Width="*" MinWidth="80" /><ColumnDefinition Width="80" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Nombre / CAS" /><TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="Catálogo" /><TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="Lote" /><TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Text="Marca" /><TextBlock Grid.Column="4" VerticalAlignment="Center" FontWeight="SemiBold" Text="Pureza" /><TextBlock Grid.Column="5" VerticalAlignment="Center" FontWeight="SemiBold" Text="Expiración" /><TextBlock Grid.Column="6" VerticalAlignment="Center" FontWeight="SemiBold" Text="Estado" /><TextBlock Grid.Column="7" VerticalAlignment="Center" FontWeight="SemiBold" Text="Disponible" />
                    </Grid>
                    <ListView x:Name="MaterialsList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items}" SelectedItem="{x:Bind ViewModel.SelectedMaterial, Mode=TwoWay}" SelectionChanged="OnMaterialSelected">
                        <ListView.ItemTemplate><DataTemplate x:DataType="contracts:ReferenceMaterialSummary">
                            <Grid MinHeight="58" Padding="8,6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="150" /><ColumnDefinition Width="*" MinWidth="90" /><ColumnDefinition Width="*" MinWidth="80" /><ColumnDefinition Width="*" MinWidth="80" /><ColumnDefinition Width="80" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" /><TextBlock Style="{StaticResource LimsCaptionStyle}" Text="{x:Bind CasNumber}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind CatalogNumber}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind Lot}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind Brand}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{x:Bind PurityPercent}" /><TextBlock Grid.Column="5" VerticalAlignment="Center" Text="{x:Bind ExpirationDate}" /><Border Grid.Column="6" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{ThemeResource LimsSurfaceSecondaryBrush}" CornerRadius="6"><TextBlock FontSize="12" Text="{x:Bind StatusLabel}" /></Border><TextBlock Grid.Column="7" VerticalAlignment="Center" Text="{x:Bind AvailableDisplay}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="1" MaxWidth="300" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{x:Bind ViewModel.HasNoItems, Mode=OneWay}"><FontIcon FontSize="26" Foreground="{ThemeResource LimsTextTertiaryBrush}" Glyph="&#xE8A5;" /><TextBlock HorizontalAlignment="Center" Style="{StaticResource LimsSectionTitleStyle}" Text="Sin estándares" /><TextBlock TextAlignment="Center" Style="{StaticResource LimsBodyStyle}" Text="No hay registros para los filtros seleccionados." /></StackPanel>
                    <Grid Grid.Row="2" Padding="14,8" Background="{ThemeResource LimsSurfaceSecondaryBrush}" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Style="{StaticResource LimsCaptionStyle}" Text="{x:Bind ViewModel.PaginationText, Mode=OneWay}" /><Button Grid.Column="1" Click="OnPreviousPageClick" IsEnabled="{x:Bind ViewModel.CanGoToPreviousPage, Mode=OneWay}" ToolTipService.ToolTip="Página anterior"><FontIcon Glyph="&#xE76B;" /></Button><Button Grid.Column="2" Click="OnNextPageClick" IsEnabled="{x:Bind ViewModel.CanGoToNextPage, Mode=OneWay}" ToolTipService.ToolTip="Página siguiente"><FontIcon Glyph="&#xE76C;" /></Button></Grid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Padding="20" Background="{ThemeResource LimsSurfaceBrush}" BorderBrush="{ThemeResource LimsBorderBrush}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <StackPanel x:Name="NoSelectionPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><FontIcon FontSize="26" Foreground="{ThemeResource LimsTextTertiaryBrush}" Glyph="&#xE8A5;" /><TextBlock Style="{StaticResource LimsSectionTitleStyle}" Text="Seleccione un estándar" /><TextBlock TextAlignment="Center" Style="{StaticResource LimsBodyStyle}" Text="Aquí verá identificación, disponibilidad y auditoría." /></StackPanel>
                    <Grid x:Name="DetailPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="2"><TextBlock FontSize="22" FontWeight="SemiBold" Text="{x:Bind ViewModel.SelectedDetail.Name, Mode=OneWay}" TextWrapping="Wrap" /><TextBlock Style="{StaticResource LimsCaptionStyle}" Text="{x:Bind ViewModel.SelectedDetail.StatusLabel, Mode=OneWay}" /></StackPanel><Button Grid.Column="1" Click="OnEditClick" Content="Editar" IsEnabled="{x:Bind ViewModel.CanEditSelected, Mode=OneWay}" /><Button Grid.Column="2" Click="OnReplaceClick" Content="Reemplazar" IsEnabled="{x:Bind ViewModel.CanReplaceSelected, Mode=OneWay}" /><Button Grid.Column="3" Click="OnArchiveClick" Content="Archivar" IsEnabled="{x:Bind ViewModel.CanArchiveSelected, Mode=OneWay}" /></Grid>
                        <ScrollViewer Grid.Row="1" Margin="0,16,0,0"><StackPanel Spacing="18">
                            <StackPanel Spacing="8"><TextBlock Style="{StaticResource LimsSectionTitleStyle}" Text="Identificación" /><Grid ColumnSpacing="14" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Style="{StaticResource LimsCaptionStyle}" Text="CAS" /><TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.CasNumber, Mode=OneWay}" /><TextBlock Grid.Row="1" Style="{StaticResource LimsCaptionStyle}" Text="Catálogo" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.CatalogNumber, Mode=OneWay}" /><TextBlock Grid.Row="2" Style="{StaticResource LimsCaptionStyle}" Text="Método" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.Method, Mode=OneWay}" /><TextBlock Grid.Row="3" Style="{StaticResource LimsCaptionStyle}" Text="Lote" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.Lot, Mode=OneWay}" /><TextBlock Grid.Row="4" Style="{StaticResource LimsCaptionStyle}" Text="Marca" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.Brand, Mode=OneWay}" /><TextBlock Grid.Row="5" Style="{StaticResource LimsCaptionStyle}" Text="Pureza" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.PurityPercent, Mode=OneWay}" /></Grid></StackPanel>
                            <StackPanel Spacing="8"><TextBlock Style="{StaticResource LimsSectionTitleStyle}" Text="Presentación y disponibilidad" /><Grid ColumnSpacing="14" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Style="{StaticResource LimsCaptionStyle}" Text="Por unidad" /><TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.PresentationQuantity, Mode=OneWay}" /><TextBlock Grid.Row="1" Style="{StaticResource LimsCaptionStyle}" Text="Unidades" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.PackageCount, Mode=OneWay}" /><TextBlock Grid.Row="2" Style="{StaticResource LimsCaptionStyle}" Text="Total inicial" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.TotalDisplay, Mode=OneWay}" /><TextBlock Grid.Row="3" Style="{StaticResource LimsCaptionStyle}" Text="Disponible" /><TextBlock Grid.Row="3" Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind ViewModel.SelectedDetail.AvailableDisplay, Mode=OneWay}" /></Grid></StackPanel>
                            <StackPanel Spacing="8"><TextBlock Style="{StaticResource LimsSectionTitleStyle}" Text="Conservación" /><Grid ColumnSpacing="14" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Style="{StaticResource LimsCaptionStyle}" Text="Ingreso" /><TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.ReceivedDate, Mode=OneWay}" /><TextBlock Grid.Row="1" Style="{StaticResource LimsCaptionStyle}" Text="Expiración" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.ExpirationDate, Mode=OneWay}" /><TextBlock Grid.Row="2" Style="{StaticResource LimsCaptionStyle}" Text="Ubicación" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.StorageLocation, Mode=OneWay}" TextWrapping="Wrap" /><TextBlock Grid.Row="3" Style="{StaticResource LimsCaptionStyle}" Text="Condiciones" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.StorageConditions, Mode=OneWay}" TextWrapping="Wrap" /></Grid></StackPanel>
                            <StackPanel Spacing="8"><TextBlock Style="{StaticResource LimsSectionTitleStyle}" Text="Auditoría" /><Grid ColumnSpacing="14" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Style="{StaticResource LimsCaptionStyle}" Text="Creado por" /><TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.CreatedByUserId, Mode=OneWay}" /><TextBlock Grid.Row="1" Style="{StaticResource LimsCaptionStyle}" Text="Creado" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.CreatedAt, Mode=OneWay}" /><TextBlock Grid.Row="2" Style="{StaticResource LimsCaptionStyle}" Text="Modificado por" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.UpdatedByUserId, Mode=OneWay}" /><TextBlock Grid.Row="3" Style="{StaticResource LimsCaptionStyle}" Text="Modificado" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.UpdatedAt, Mode=OneWay}" /><TextBlock Grid.Row="4" Style="{StaticResource LimsCaptionStyle}" Text="Motivo de baja" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.ArchiveReason, Mode=OneWay}" TextWrapping="Wrap" /></Grid></StackPanel>
                        </StackPanel></ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <ProgressBar Grid.RowSpan="4" Height="3" VerticalAlignment="Top" IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
    </Grid>
</Page>
