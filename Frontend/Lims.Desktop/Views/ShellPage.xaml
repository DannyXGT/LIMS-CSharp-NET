<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lims.Desktop.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="using:Lims.DesignSystem.Controls"
    Background="{ThemeResource LimsBackgroundBrush}">
    <NavigationView
        x:Name="MainNavigation"
        AlwaysShowHeader="True"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        OpenPaneLength="252"
        PaneDisplayMode="Left"
        PaneOpening="OnPaneOpening"
        PaneClosing="OnPaneClosing"
        Loaded="OnNavigationLoaded"
        ItemInvoked="OnNavigationItemInvoked"
        SelectionChanged="OnSelectionChanged">
        <NavigationView.PaneHeader>
            <StackPanel x:Name="BrandLabels" Margin="4,18,4,14" Spacing="3">
                <TextBlock Style="{StaticResource LimsProductTitleStyle}" Text="LIMS" />
                <TextBlock Style="{StaticResource LimsCaptionStyle}" Text="Gestión de laboratorio" />
            </StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="HomeItem" design:LimsIcon.NavigationIcon="Home" Content="Inicio" Tag="home" AutomationProperties.Name="Inicio" ToolTipService.ToolTip="Inicio"></NavigationViewItem>
            <NavigationViewItemSeparator />
            <NavigationViewItemHeader x:Name="MaterialsGroup" Content="MATERIALES DE REFERENCIA" />
            <NavigationViewItem x:Name="StandardsItem" design:LimsIcon.NavigationIcon="Standards" Content="Estándares" AutomationProperties.Name="Estándares" ToolTipService.ToolTip="Estándares" IsEnabled="{x:Bind ViewModel.CanViewReferenceMaterials, Mode=OneWay}" Tag="standards"></NavigationViewItem>
            <NavigationViewItem x:Name="PreparationsItem" design:LimsIcon.NavigationIcon="Preparations" Content="Preparaciones" AutomationProperties.Name="Preparaciones" ToolTipService.ToolTip="Preparaciones" IsEnabled="{x:Bind ViewModel.CanViewReferenceMaterials, Mode=OneWay}" Tag="preparations" />
            <NavigationViewItemHeader x:Name="AdministrationGroup" Content="ADMINISTRACIÓN" Visibility="Collapsed" />
            <NavigationViewItem x:Name="PermissionsItem" design:LimsIcon.NavigationIcon="Administration" Content="Gestión de permisos" Tag="permissions" AutomationProperties.Name="Gestión de permisos" ToolTipService.ToolTip="Gestión de permisos" Visibility="Collapsed" />
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <Grid x:Name="UserArea" Margin="4,8,4,12" Padding="0,10,0,0" BorderBrush="{ThemeResource LimsBorderBrush}" BorderThickness="0,1,0,0" ColumnSpacing="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button x:Name="UserAvatar" Width="32" Height="32" MinHeight="32" Padding="0" HorizontalAlignment="Center"
                    Style="{StaticResource LimsSecondaryButtonStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.DisplayName, Mode=OneWay}" AutomationProperties.Name="Menú de usuario">
                    <Button.Flyout><MenuFlyout><MenuFlyoutItem design:LimsIcon.NavigationIcon="SignOut" AutomationProperties.Name="Cerrar sesión" Text="Cerrar sesión" Command="{x:Bind ViewModel.LogoutCommand}" /></MenuFlyout></Button.Flyout>
                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="{x:Bind ViewModel.Initials, Mode=OneWay}" />
                </Button>
                <StackPanel x:Name="UserLabels" Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.DisplayName, Mode=OneWay}" />
                    <TextBlock FontSize="11" Foreground="{ThemeResource LimsTextSecondaryBrush}" Text="{x:Bind ViewModel.Role, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button x:Name="LogoutButton" Grid.Column="2" Style="{StaticResource LimsIconButtonStyle}" AutomationProperties.Name="Cerrar sesión" Command="{x:Bind ViewModel.LogoutCommand}" ToolTipService.ToolTip="Cerrar sesión">
                    <design:LimsIcon Icon="SignOut" Size="{StaticResource IconSizeMedium}" />
                </Button>
            </Grid>
        </NavigationView.PaneFooter>
        <NavigationView.Header>
            <Grid Margin="0,0,24,0" ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="SectionTitle" FontSize="22" FontWeight="SemiBold" Text="Inicio" />
                    <TextBlock x:Name="SectionSubtitle" Style="{StaticResource LimsCaptionStyle}" Text="Panel principal" />
                </StackPanel>
                <Button
                    x:Name="StandardsNewButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Click="OnNewStandardClick"
                    Style="{StaticResource LimsPrimaryButtonStyle}"
                    AutomationProperties.Name="Nuevo estándar"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <design:LimsIcon Icon="NewStandard" Size="{StaticResource IconSizeSmall}" Foreground="{ThemeResource LimsOnAccentBrush}" />
                        <TextBlock Text="Nuevo estándar" />
                    </StackPanel>
                </Button>
                <Button x:Name="PreparationsNewButton" Grid.Column="1" VerticalAlignment="Center"
                    Click="OnNewPreparationClick" Style="{StaticResource LimsPrimaryButtonStyle}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <design:LimsIcon Icon="NewStandard" Size="{StaticResource IconSizeSmall}" Foreground="{ThemeResource LimsOnAccentBrush}" />
                        <TextBlock x:Name="PreparationsNewLabel" Text="Nuevo Stock" />
                    </StackPanel>
                </Button>
            </Grid>
        </NavigationView.Header>
        <Grid Padding="24,8,24,24" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <InfoBar IsOpen="{x:Bind ViewModel.HasAccessWarning, Mode=OneWay}" IsClosable="False" Severity="Warning" Message="{x:Bind ViewModel.SessionMessage, Mode=OneWay}">
                <InfoBar.ActionButton><Button Content="Reintentar" Click="OnRetryAccessClick" /></InfoBar.ActionButton>
            </InfoBar>
            <TextBlock Grid.Row="1" x:Name="DeniedPanel" Text="Acceso denegado. No tiene permiso para consultar esta pantalla." Style="{StaticResource LimsBodyStyle}" Visibility="Collapsed" />
            <ContentControl Grid.Row="1" x:Name="PermissionsHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
            <ContentControl Grid.Row="1" x:Name="HomePanel" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            <ContentControl
                Grid.Row="1" x:Name="PreparationsHost"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="Collapsed" />
            <ContentControl
                Grid.Row="1" x:Name="StandardsHost"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="Collapsed" />
        </Grid>
    </NavigationView>
</Page>
