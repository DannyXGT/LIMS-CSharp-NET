<ContentDialog x:Class="Lims.Desktop.Views.SolutionGroupEditorDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:design="using:Lims.DesignSystem.Controls" xmlns:vm="using:Lims.Desktop.ViewModels" xmlns:local="using:Lims.Desktop.Controls"
 Style="{StaticResource LimsEditorDialogStyle}" Opened="OnOpened" Closing="OnClosing" Closed="OnClosed" Language="es-GT">
 <ContentDialog.Resources>
  <Style x:Key="GroupErrorStyle" TargetType="TextBlock" BasedOn="{StaticResource LimsInlineErrorStyle}"><Setter Property="Visibility" Value="Visible"/></Style>
  <x:Double x:Key="ContentDialogMaxWidth">1320</x:Double><x:Double x:Key="ContentDialogMaxHeight">1200</x:Double>
 </ContentDialog.Resources>
 <Grid x:Name="EditorRoot" RowSpacing="6">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Spacing="3"><TextBlock Text="{x:Bind ViewModel.CreateLabel}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{x:Bind ViewModel.WorkflowDescription}" Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap"/></StackPanel>
  <ScrollViewer x:Name="EditorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <ContentControl x:Name="FormSurface" HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.InputsEnabled, Mode=OneWay}">
    <StackPanel Spacing="12" Padding="0,0,12,8">
     <Grid x:Name="IdentityGrid" ColumnSpacing="12" RowSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBox x:Name="CodeBox" Header="{x:Bind ViewModel.CodeLabel}" Text="{x:Bind ViewModel.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Style="{StaticResource LimsCompactTextBoxStyle}" AutomationProperties.Name="Código del grupo"/>
      <TextBox x:Name="NameBox" Grid.Column="1" Header="Nombre de la preparación" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Style="{StaticResource LimsCompactTextBoxStyle}"/>
      <StackPanel x:Name="MethodField" Grid.Column="2" Spacing="5"><TextBlock x:Name="MethodLabel" Text="Método" Style="{StaticResource LimsFormLabelStyle}"/><design:LimsSearchSelect x:Name="MethodSelect" ItemsSource="{x:Bind ViewModel.Methods}" SelectedItem="{x:Bind ViewModel.Method, Mode=TwoWay}" DisplayMemberPath="Name" PlaceholderText="Seleccione método" AutomationProperties.Name="Método del grupo"/></StackPanel>
     </Grid>
     <Grid x:Name="DateGrid" ColumnSpacing="12" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Spacing="5"><TextBlock Text="Preparación" Style="{StaticResource LimsFormLabelStyle}"/><design:LimsDatePicker x:Name="PreparationPicker" DateChanged="OnPreparationChanged" AutomationProperties.Name="Fecha de preparación"/></StackPanel>
      <StackPanel x:Name="ExpirationField" Grid.Column="1" Spacing="5"><TextBlock Text="Expiración" Style="{StaticResource LimsFormLabelStyle}"/><design:LimsDatePicker x:Name="ExpirationPicker" DateChanged="OnExpirationChanged" AutomationProperties.Name="Fecha de expiración"/></StackPanel>
      <StackPanel x:Name="ResponsibleField" Grid.Column="2" Spacing="5"><TextBlock Text="Responsable" Style="{StaticResource LimsFormLabelStyle}"/><TextBlock Text="{x:Bind ViewModel.PreparedBy}" FontSize="13" TextWrapping="Wrap"/></StackPanel>
     </Grid>
     <Grid x:Name="Workspace" ColumnSpacing="16" RowSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ResultColumn" Width="380"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Spacing="8">
       <TextBlock Text="{x:Bind ViewModel.AdditivesMessage, Mode=OneWay}" Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap"/>
       <Grid><TextBlock Text="{x:Bind ViewModel.SolutionsLabel}" Style="{StaticResource LimsSectionTitleStyle}" FontSize="13"/><Button Content="Actualizar orígenes" HorizontalAlignment="Right" Click="OnRefresh" Style="{StaticResource LimsUtilityActionStyle}"/></Grid>
       <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="{x:Bind ViewModel.AddLabel}" Click="OnAdd" IsEnabled="{x:Bind ViewModel.CanAddComponent, Mode=OneWay}" Style="{StaticResource LimsAddActionStyle}"/></StackPanel>
       <ItemsControl ItemsSource="{x:Bind ViewModel.Components}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SolutionPartViewModel">
        <Border Background="{ThemeResource LimsSurfaceSecondaryBrush}" BorderBrush="{ThemeResource LimsBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
         <StackPanel Spacing="6">
          <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
           <Button design:LimsAction.Icon="ViewDetail" Grid.Column="1" Content="Ver resultado" Tag="{x:Bind}" Click="OnSelectResult" Style="{StaticResource LimsUtilityActionStyle}"/>
           <Button ToolTipService.ToolTip="Eliminar" Grid.Column="2" Tag="{x:Bind}" Click="OnRemove" Style="{StaticResource LimsRemoveActionStyle}" AutomationProperties.Name="Quitar solución" />
          </Grid>
          <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <design:LimsSearchSelect ItemsSource="{x:Bind SourceOptions}" SelectedItem="{x:Bind SourceOption, Mode=TwoWay}" DisplayMemberPath="Label" PlaceholderText="Seleccione origen interno o comercial" AutomationProperties.Name="Origen de la solución" Loaded="OnPopupLoaded"/>
          </Grid>
          <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
           <TextBlock Text="Tomado" FontSize="11" VerticalAlignment="Center"/>
           <TextBox Grid.Column="1" Text="{x:Bind Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LimsCompactTextBoxStyle}" AutomationProperties.Name="Volumen tomado" Tag="{x:Bind}" Loaded="OnVolumeLoaded"/>
           <design:LimsSelect Grid.Column="2" ItemsSource="{x:Bind Units}" SelectedItem="{x:Bind Unit, Mode=TwoWay}" AutomationProperties.Name="Unidad tomada" Loaded="OnPopupLoaded"/>
           <TextBlock Grid.Column="3" Text="Aforo" FontSize="11" VerticalAlignment="Center"/>
           <TextBox Grid.Column="4" Text="{x:Bind FinalVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LimsCompactTextBoxStyle}" AutomationProperties.Name="Volumen de aforo" Tag="{x:Bind}" Loaded="OnVolumeLoaded"/>
           <design:LimsSelect Grid.Column="5" ItemsSource="{x:Bind Units}" SelectedItem="{x:Bind FinalUnit, Mode=TwoWay}" AutomationProperties.Name="Unidad de aforo" Loaded="OnPopupLoaded"/>
          </Grid>
          <TextBlock Text="Solvente de aforo" Style="{StaticResource LimsFormLabelStyle}"/>
          <design:LimsSearchSelect ItemsSource="{x:Bind Solvents}" SelectedItem="{x:Bind Solvent, Mode=TwoWay}" DisplayMemberPath="Display" PlaceholderText="Seleccione solvente" AutomationProperties.Name="Solvente de aforo" Loaded="OnPopupLoaded"/>
          <TextBlock Text="Estándar interno · Intermedia (opcional)" Style="{StaticResource LimsFormLabelStyle}"/>
          <design:LimsSearchSelect ItemsSource="{x:Bind InternalStandardSources}" SelectedItem="{x:Bind InternalStandardSource, Mode=TwoWay}" DisplayMemberPath="SearchDisplay" PlaceholderText="Seleccione una Intermedia" AutomationProperties.Name="Intermedia del estándar interno" Loaded="OnPopupLoaded"/>
          <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBox Header="Volumen de estándar interno" Text="{x:Bind InternalStandardVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LimsCompactTextBoxStyle}" AutomationProperties.Name="Volumen de estándar interno" Tag="{x:Bind}" Loaded="OnVolumeLoaded"/>
           <design:LimsSelect Grid.Column="1" VerticalAlignment="Bottom" ItemsSource="{x:Bind Units}" SelectedItem="{x:Bind InternalStandardUnit, Mode=TwoWay}" AutomationProperties.Name="Unidad de estándar interno" Loaded="OnPopupLoaded"/>
           <Button Grid.Column="2" VerticalAlignment="Bottom" Content="Quitar" Tag="{x:Bind}" Click="OnClearInternal" Style="{StaticResource LimsUtilityActionStyle}" AutomationProperties.Name="Quitar estándar interno"/>
          </Grid>
          <TextBlock Text="{x:Bind Source.MetadataDisplay, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"/>
           <TextBlock Text="{x:Bind CardSummary, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource LimsTextSecondaryBrush}" TextWrapping="Wrap"/>
          <TextBlock Text="{x:Bind FieldError, Mode=OneWay}" Visibility="{x:Bind HasFieldError, Mode=OneWay}" Style="{StaticResource GroupErrorStyle}" TextWrapping="Wrap"/>
         </StackPanel>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <Expander Header="Almacenamiento y observaciones" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="8"><TextBox Header="Temperatura de almacenamiento (opcional)" Text="{x:Bind ViewModel.StorageTemperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Style="{StaticResource LimsCompactTextBoxStyle}"/><TextBox Header="Observaciones" Text="{x:Bind ViewModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource LimsCompactTextBoxStyle}"/></StackPanel></Expander>
      </StackPanel>
      <ScrollViewer x:Name="ResultViewport" Grid.Column="1" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0"><StackPanel x:Name="ResultPanel" Spacing="10" VerticalAlignment="Top">
       <TextBlock Text="RESULTADO POR SOLUCIÓN" Style="{StaticResource LimsSectionTitleStyle}" FontSize="13"/>
       <design:LimsSelect x:Name="ResultSelect" ItemsSource="{x:Bind ViewModel.Components}" SelectedItem="{x:Bind ViewModel.SelectedComponent, Mode=TwoWay}" DisplayMemberPath="Title" AutomationProperties.Name="Solución a visualizar" Loaded="OnPopupLoaded"/>
       <Border Padding="12" CornerRadius="8" Background="{ThemeResource LimsSurfaceSecondaryBrush}" BorderBrush="{ThemeResource LimsBorderBrush}" BorderThickness="1"><local:SolutionResultView x:Name="ResultView"/></Border>
       <TextBlock Text="DISPONIBILIDAD POR ORIGEN" Style="{StaticResource LimsSectionTitleStyle}" FontSize="13"/>
       <TextBlock x:Name="DebitHint" Text="Complete el grupo para consultar el consumo compartido." Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap"/>
       <StackPanel x:Name="DebitRows" Spacing="8"/>
      </StackPanel></ScrollViewer>
     </Grid>
    </StackPanel>
   </ContentControl>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Spacing="4"><TextBlock Text="{x:Bind ViewModel.VisibleValidation, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasVisibleValidation, Mode=OneWay}" Style="{StaticResource GroupErrorStyle}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}" Style="{StaticResource GroupErrorStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite"/></StackPanel>
  <Grid Grid.Row="3" BorderBrush="{ThemeResource LimsBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="SuccessText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><ProgressRing Width="22" Height="22" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/><Button x:Name="CancelButton" Content="Cancelar" Click="OnCancel" Style="{StaticResource LimsActionButtonStyle}"/><Button design:LimsAction.Icon="ViewDetail" x:Name="ViewButton" Content="Ver preparación" Click="OnView" Visibility="Collapsed" Style="{StaticResource LimsUtilityActionStyle}"/><Button x:Name="SaveButton" Content="{x:Bind ViewModel.SaveLabel}" Click="OnSave" IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}" Style="{StaticResource LimsPrimaryActionStyle}"/></StackPanel>
  </Grid>
 </Grid>
</ContentDialog>
