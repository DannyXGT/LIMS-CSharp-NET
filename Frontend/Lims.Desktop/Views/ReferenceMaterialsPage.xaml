<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lims.Desktop.Views.ReferenceMaterialsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contracts="using:Lims.Contracts.ReferenceMaterials"
    Background="Transparent"
    Loaded="OnLoaded"
    SizeChanged="OnPageSizeChanged">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="12" Background="{ThemeResource LimsSurfaceBrush}" BorderBrush="{ThemeResource LimsBorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid x:Name="FilterGrid" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SearchFilterColumn" Width="2*" MinWidth="240" />
                    <ColumnDefinition x:Name="StatusFilterColumn" Width="150" />
                    <ColumnDefinition x:Name="MethodFilterColumn" Width="170" />
                    <ColumnDefinition x:Name="ApplyFilterColumn" Width="Auto" />
                    <ColumnDefinition x:Name="ClearFilterColumn" Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    VerticalAlignment="Bottom"
                    PlaceholderText="Buscar por nombre, CAS, catálogo, lote o marca"
                    QueryIcon="Find"
                    QuerySubmitted="OnSearchSubmitted"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox x:Name="StatusCombo" Grid.Column="1" Header="Estado" SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="Todos" Tag="" IsSelected="True" />
                    <ComboBoxItem Content="Activo" Tag="Active" />
                    <ComboBoxItem Content="Agotado" Tag="Depleted" />
                    <ComboBoxItem Content="Vencido" Tag="Expired" />
                    <ComboBoxItem Content="Bloqueado" Tag="Blocked" />
                    <ComboBoxItem Content="Reemplazado" Tag="Replaced" />
                    <ComboBoxItem Content="Archivado" Tag="Archived" />
                    <ComboBoxItem Content="Retirado" Tag="Retired" />
                </ComboBox>
                <TextBox x:Name="MethodBox" Grid.Column="2" Header="Método" PlaceholderText="Todos" TextChanged="OnMethodChanged" />
                <Button x:Name="ApplyFiltersButton" Grid.Column="3" VerticalAlignment="Bottom" Click="OnApplyFiltersClick" Content="Aplicar" />
                <Button x:Name="ClearFiltersButton" Grid.Column="4" VerticalAlignment="Bottom" AutomationProperties.Name="Limpiar filtros" Click="OnClearFiltersClick" ToolTipService.ToolTip="Limpiar filtros">
                    <FontIcon Glyph="&#xE894;" />
                </Button>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Spacing="6">
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsCatalogsLoading, Mode=OneWay}"
                Message="Cargando métodos, unidades y ubicaciones..."
                Severity="Informational" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasCatalogMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.CatalogMessage, Mode=OneWay}"
                Severity="Warning" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                Severity="Warning" />
        </StackPanel>

        <Grid x:Name="WorkspaceGrid" Grid.Row="2" ColumnSpacing="14" RowSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="WorkspaceTableColumn" Width="7*" />
                <ColumnDefinition x:Name="WorkspaceDetailColumn" Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="WorkspaceTableRow" Height="*" />
                <RowDefinition x:Name="WorkspaceDetailRow" Height="0" />
            </Grid.RowDefinitions>

            <Border
                x:Name="TableBorder"
                Background="{ThemeResource LimsSurfaceBrush}"
                BorderBrush="{ThemeResource LimsBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Padding="12,0" Background="{ThemeResource LimsSurfaceSecondaryBrush}" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="94" />
                            <ColumnDefinition Width="104" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Nombre / CAS" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="Catálogo" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="Lote" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Text="Marca" />
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" FontWeight="SemiBold" Text="Pureza" />
                        <TextBlock Grid.Column="5" VerticalAlignment="Center" FontWeight="SemiBold" Text="Expiración" />
                        <TextBlock Grid.Column="6" VerticalAlignment="Center" FontWeight="SemiBold" Text="Estado" />
                        <TextBlock Grid.Column="7" VerticalAlignment="Center" FontWeight="SemiBold" Text="Disponible" />
                    </Grid>

                    <ListView
                        x:Name="MaterialsList"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Items}"
                        SelectedItem="{x:Bind ViewModel.SelectedMaterial, Mode=TwoWay}"
                        SelectionChanged="OnMaterialSelected">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="54" />
                                <Setter Property="Padding" Value="4,2" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="contracts:ReferenceMaterialSummary">
                                <Grid MinHeight="52" Padding="8,5" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="94" />
                                        <ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource LimsCaptionStyle}" Text="{x:Bind CasNumber}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind CatalogNumber}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind Lot}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind Brand}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{x:Bind PurityPercent}" />
                                    <TextBlock Grid.Column="5" VerticalAlignment="Center" Text="{x:Bind ExpirationDate}" />
                                    <Border Grid.Column="6" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{ThemeResource LimsSurfaceSecondaryBrush}" CornerRadius="6">
                                        <TextBlock FontSize="12" Text="{x:Bind StatusLabel}" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <TextBlock Grid.Column="7" VerticalAlignment="Center" Text="{x:Bind AvailableDisplay}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        Grid.Row="1"
                        MaxWidth="340"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="7"
                        Visibility="{x:Bind ViewModel.HasNoItems, Mode=OneWay}">
                        <FontIcon HorizontalAlignment="Center" FontSize="24" Foreground="{ThemeResource LimsTextTertiaryBrush}" Glyph="&#xE8A5;" />
                        <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="No hay estándares registrados" />
                        <TextBlock TextAlignment="Center" Style="{StaticResource LimsCaptionStyle}" Text="Cree el primer estándar para comenzar." />
                        <Button HorizontalAlignment="Center" Margin="0,4,0,0" Click="OnCreateClick" Content="Nuevo estándar" IsEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}" />
                    </StackPanel>

                    <Grid Grid.Row="2" Padding="12,7" Background="{ThemeResource LimsSurfaceSecondaryBrush}" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource LimsCaptionStyle}" Text="{x:Bind ViewModel.PaginationText, Mode=OneWay}" />
                        <Button Grid.Column="1" Click="OnPreviousPageClick" IsEnabled="{x:Bind ViewModel.CanGoToPreviousPage, Mode=OneWay}" ToolTipService.ToolTip="Página anterior">
                            <FontIcon Glyph="&#xE76B;" />
                        </Button>
                        <Button Grid.Column="2" Click="OnNextPageClick" IsEnabled="{x:Bind ViewModel.CanGoToNextPage, Mode=OneWay}" ToolTipService.ToolTip="Página siguiente">
                            <FontIcon Glyph="&#xE76C;" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <Border
                x:Name="DetailBorder"
                Grid.Column="1"
                Padding="18"
                Background="{ThemeResource LimsSurfaceBrush}"
                BorderBrush="{ThemeResource LimsBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <StackPanel x:Name="NoSelectionPanel" MaxWidth="280" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                        <FontIcon HorizontalAlignment="Center" FontSize="24" Foreground="{ThemeResource LimsTextTertiaryBrush}" Glyph="&#xE8A5;" />
                        <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Seleccione un estándar" />
                        <TextBlock TextAlignment="Center" Style="{StaticResource LimsBodyStyle}" Text="Aquí verá identificación, disponibilidad y auditoría." />
                    </StackPanel>

                    <Grid x:Name="DetailPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Bind ViewModel.SelectedDetail.Name, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Foreground="{ThemeResource LimsAccentHoverBrush}" Text="{x:Bind ViewModel.SelectedDetail.StatusLabel, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal" Spacing="8">
                            <Button Click="OnEditClick" Content="Editar" IsEnabled="{x:Bind ViewModel.CanEditSelected, Mode=OneWay}" />
                            <Button Click="OnReplaceClick" Content="Reemplazar" IsEnabled="{x:Bind ViewModel.CanReplaceSelected, Mode=OneWay}" />
                            <Button Click="OnArchiveClick" Content="Archivar" IsEnabled="{x:Bind ViewModel.CanArchiveSelected, Mode=OneWay}" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="2" Margin="0,16,0,0" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="18">
                                <StackPanel Spacing="8">
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="Identificación" />
                                    <Grid ColumnSpacing="12" RowSpacing="7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource LimsCaptionStyle}" Text="CAS" /><TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.CasNumber, Mode=OneWay}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="1" Style="{StaticResource LimsCaptionStyle}" Text="Catálogo" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.CatalogNumber, Mode=OneWay}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="2" Style="{StaticResource LimsCaptionStyle}" Text="Método" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.Method, Mode=OneWay}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="3" Style="{StaticResource LimsCaptionStyle}" Text="Lote" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.Lot, Mode=OneWay}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="4" Style="{StaticResource LimsCaptionStyle}" Text="Marca" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.Brand, Mode=OneWay}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="5" Style="{StaticResource LimsCaptionStyle}" Text="Pureza" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.PurityPercent, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="8">
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="Vigencia y almacenamiento" />
                                    <Grid ColumnSpacing="12" RowSpacing="7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource LimsCaptionStyle}" Text="Ingreso" /><TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.ReceivedDate, Mode=OneWay}" />
                                        <TextBlock Grid.Row="1" Style="{StaticResource LimsCaptionStyle}" Text="Expiración" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.ExpirationDate, Mode=OneWay}" />
                                        <TextBlock Grid.Row="2" Style="{StaticResource LimsCaptionStyle}" Text="Ubicación" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.StorageLocation, Mode=OneWay}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="3" Style="{StaticResource LimsCaptionStyle}" Text="Temperatura" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.StorageTemperature, Mode=OneWay}" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="8">
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="Presentación y disponibilidad" />
                                    <Grid ColumnSpacing="12" RowSpacing="7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource LimsCaptionStyle}" Text="Por unidad" /><TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.PresentationQuantity, Mode=OneWay}" />
                                        <TextBlock Grid.Row="1" Style="{StaticResource LimsCaptionStyle}" Text="N.º unidades" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.PackageCount, Mode=OneWay}" />
                                        <TextBlock Grid.Row="2" Style="{StaticResource LimsCaptionStyle}" Text="Total inicial" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.TotalDisplay, Mode=OneWay}" />
                                        <TextBlock Grid.Row="3" Style="{StaticResource LimsCaptionStyle}" Text="Disponible" /><TextBlock Grid.Row="3" Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind ViewModel.SelectedDetail.AvailableDisplay, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="8">
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="Auditoría" />
                                    <Grid ColumnSpacing="12" RowSpacing="7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource LimsCaptionStyle}" Text="Creado por" /><TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.CreatedByUserId, Mode=OneWay}" />
                                        <TextBlock Grid.Row="1" Style="{StaticResource LimsCaptionStyle}" Text="Creado" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.CreatedAt, Mode=OneWay}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="2" Style="{StaticResource LimsCaptionStyle}" Text="Modificado por" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.UpdatedByUserId, Mode=OneWay}" />
                                        <TextBlock Grid.Row="3" Style="{StaticResource LimsCaptionStyle}" Text="Modificado" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.UpdatedAt, Mode=OneWay}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="4" Style="{StaticResource LimsCaptionStyle}" Text="Motivo de baja" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.SelectedDetail.ArchiveReason, Mode=OneWay}" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <ProgressBar Grid.RowSpan="3" Height="3" VerticalAlignment="Top" IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
    </Grid>
</Page>
