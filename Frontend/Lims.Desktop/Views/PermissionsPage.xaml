<Page x:Class="Lims.Desktop.Views.PermissionsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:design="using:Lims.DesignSystem.Controls" Background="Transparent">
 <Grid RowSpacing="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Spacing="4"><TextBlock Style="{StaticResource LimsSectionTitleStyle}" Text="Laboratorio Analítico"/><TextBlock Style="{StaticResource LimsCaptionStyle}" Text="Permisos individuales · Usuarios activos del departamento"/></StackPanel>
  <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}" IsClosable="False" Severity="Informational" Message="{x:Bind ViewModel.Message, Mode=OneWay}" />
  <Grid Grid.Row="2" ColumnSpacing="16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Padding="14" Background="{ThemeResource LimsSurfaceBrush}" BorderBrush="{ThemeResource LimsBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource LimsSurfaceCornerRadius}">
    <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <AutoSuggestBox design:LimsIcon.NavigationIcon="Search" PlaceholderText="Buscar por nombre o correo" Text="{x:Bind ViewModel.Search, Mode=TwoWay}" QuerySubmitted="OnSearch" AutomationProperties.Name="Buscar usuarios por nombre o correo" />
     <ListView x:Name="UsersList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Users}" SelectionMode="Single" SelectionChanged="OnUserChanged" AutomationProperties.Name="Usuarios de Laboratorio Analítico">
      <ListView.ItemTemplate><DataTemplate><StackPanel Spacing="3" Padding="0,6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Email}" Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap"/><TextBlock Text="{Binding Role}" Style="{StaticResource LimsCaptionStyle}"/></StackPanel></DataTemplate></ListView.ItemTemplate>
     </ListView>
    </Grid>
   </Border>
   <ScrollViewer x:Name="PermissionScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="14">
     <Border Padding="18" Background="{ThemeResource LimsSurfaceBrush}" BorderBrush="{ThemeResource LimsBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource LimsSurfaceCornerRadius}">
      <StackPanel Spacing="10">
       <TextBlock Text="{x:Bind ViewModel.SelectedUser.Name, Mode=OneWay}" Style="{StaticResource LimsSectionTitleStyle}"/>
       <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{x:Bind ViewModel.SelectedUser.Role, Mode=OneWay}"/><TextBlock Text="{x:Bind ViewModel.SelectedUser.Department, Mode=OneWay}" Style="{StaticResource LimsCaptionStyle}"/></StackPanel>
       <TextBlock Text="{x:Bind ViewModel.AccessNote, Mode=OneWay}" Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap"/>
       <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate>
        <StackPanel Spacing="6" Margin="0,6,0,8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Definition.Name}" IsChecked="{Binding IsGranted, Mode=TwoWay}" AutomationProperties.Name="{Binding Definition.Name}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <TextBlock Text="{x:Bind ViewModel.ChangeStatus, Mode=OneWay}" AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource LimsAccentBrush}"/>
       <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Guardar cambios" Style="{StaticResource LimsPrimaryButtonStyle}" IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}" Click="OnSave"/><Button Content="Recargar" Style="{StaticResource LimsSecondaryButtonStyle}" Click="OnReload"/></StackPanel>
      </StackPanel>
     </Border>
     <Border Padding="18" Background="{ThemeResource LimsSurfaceBrush}" BorderBrush="{ThemeResource LimsBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource LimsSurfaceCornerRadius}">
      <StackPanel Spacing="10"><TextBlock Text="Historial de cambios" Style="{StaticResource LimsSectionTitleStyle}"/>
       <ItemsControl ItemsSource="{x:Bind ViewModel.History}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Spacing="3" Margin="0,0,0,12"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding Action}" FontWeight="SemiBold"/><TextBlock Text="{Binding Permission}" TextWrapping="Wrap"/></StackPanel><TextBlock Text="{Binding Change}" Style="{StaticResource LimsCaptionStyle}"/><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding Actor}"/><TextBlock Text="{Binding At}" Style="{StaticResource LimsCaptionStyle}"/></StackPanel></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Página anterior" Click="OnPreviousHistory"/><Button Content="Más historial" IsEnabled="{x:Bind ViewModel.HasMoreHistory, Mode=OneWay}" Click="OnNextHistory"/></StackPanel>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Grid>
</Page>
