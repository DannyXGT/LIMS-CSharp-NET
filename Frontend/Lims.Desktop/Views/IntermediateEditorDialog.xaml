<ContentDialog x:Class="Lims.Desktop.Views.IntermediateEditorDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:design="using:Lims.DesignSystem.Controls" xmlns:local="using:Lims.Desktop.Views" xmlns:vm="using:Lims.Desktop.ViewModels"
 Style="{StaticResource LimsEditorDialogStyle}" Title="Nueva solución intermedia" Language="es-GT" Opened="OnOpened" Closed="OnClosed" Closing="OnClosing">
 <ContentDialog.Resources><Style x:Key="LimsValidationTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LimsInlineErrorStyle}"><Setter Property="Visibility" Value="Visible"/></Style><x:Double x:Key="ContentDialogMaxWidth">1180</x:Double><x:Double x:Key="ContentDialogMaxHeight">1000</x:Double></ContentDialog.Resources>
 <Grid x:Name="EditorRoot" RowSpacing="10">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <ContentControl x:Name="FormSurface" IsEnabled="{x:Bind ViewModel.InputsEnabled, Mode=OneWay}" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12" Padding="2,2,12,6">
    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="5"><TextBlock Text="Código" Style="{StaticResource LimsFormLabelStyle}"/><TextBlock Text="Se asignará al crear" Style="{StaticResource LimsCaptionStyle}"/><TextBlock Text="{x:Bind ViewModel.PreparedBy}" ToolTipService.ToolTip="Preparado por"/></StackPanel>
     <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Método" Style="{StaticResource LimsFormLabelStyle}"/><design:LimsSearchSelect x:Name="MethodSelect" ItemsSource="{x:Bind ViewModel.Methods}" SelectedItem="{x:Bind ViewModel.Method, Mode=TwoWay}" DisplayMemberPath="Name" PlaceholderText="Seleccione método" AutomationProperties.Name="Método"/><TextBlock Text="{x:Bind ViewModel.MethodError, Mode=OneWay}" Style="{StaticResource LimsValidationTextStyle}"/></StackPanel>
     <StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="Nombre de la solución" Style="{StaticResource LimsFormLabelStyle}"/><TextBox x:Name="NameBox" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LimsCompactTextBoxStyle}" PlaceholderText="Nombre de la Intermedia" MaxLength="200" AutomationProperties.Name="Nombre de la Intermedia"/><TextBlock Text="{x:Bind ViewModel.NameError, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasNameError, Mode=OneWay}" Style="{StaticResource LimsValidationTextStyle}"/></StackPanel>
    </Grid>
    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="5"><TextBlock Text="Preparación" Style="{StaticResource LimsFormLabelStyle}"/><design:LimsDatePicker x:Name="PreparationPicker" DateChanged="OnDateChanged" AutomationProperties.Name="Fecha de preparación"/></StackPanel>
     <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Expiración" Style="{StaticResource LimsFormLabelStyle}"/><design:LimsDatePicker x:Name="ExpirationPicker" DateChanged="OnDateChanged" AutomationProperties.Name="Fecha de expiración"/></StackPanel>
     <StackPanel Grid.Column="2" Spacing="5"><Grid><TextBlock Text="Solución a diluir" Style="{StaticResource LimsFormLabelStyle}"/><Button Content="Quitar" HorizontalAlignment="Right" Style="{StaticResource LimsSecondaryButtonStyle}" Click="OnClearParent" Padding="6,0" MinHeight="24"/></Grid><design:LimsSearchSelect x:Name="ParentSelect" ItemsSource="{x:Bind ViewModel.DilutionSources}" DisplayMemberPath="SearchDisplay" PlaceholderText="Sin dilución previa" SelectionChanged="OnParentChanged" AutomationProperties.Name="Intermedia a diluir"/></StackPanel>
    </Grid>
    <TextBlock Text="{x:Bind ViewModel.DateError, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasDateError, Mode=OneWay}" Style="{StaticResource LimsValidationTextStyle}"/>
    <Grid x:Name="Workspace" ColumnSpacing="20" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ResultColumn" Width="300"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Spacing="10">
      <Grid><TextBlock Text="COMPONENTES" Style="{StaticResource LimsSectionTitleStyle}"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6"><Button Content="Actualizar orígenes" Style="{StaticResource LimsSecondaryButtonStyle}" Click="OnRefresh" Padding="8,3" MinHeight="28" FontSize="11"/><Button Content="Limpiar" AutomationProperties.Name="Limpiar componentes" Style="{StaticResource LimsSecondaryButtonStyle}" Click="OnClear" Padding="8,3" MinHeight="28" FontSize="11"/></StackPanel></Grid>
      <TextBlock x:Name="EmptyText" Text="Agregue un Stock o seleccione una Intermedia a diluir." Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap"/>
      <ItemsControl x:Name="ComponentList" ItemsSource="{x:Bind ViewModel.Components}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:IntermediateComponentViewModel">
       <Border Padding="12" Margin="0,0,0,8" CornerRadius="10" Background="{ThemeResource LimsSurfaceSecondaryBrush}" Loaded="OnComponentLoaded">
        <StackPanel Spacing="6">
         <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><design:LimsSearchSelect ItemsSource="{x:Bind Sources}" SelectedItem="{x:Bind Source, Mode=TwoWay}" DisplayMemberPath="SearchDisplay" PlaceholderText="Buscar código, nombre, CAS o lote…" SearchPlaceholder="Buscar código, nombre, CAS o lote" AutomationProperties.Name="Origen del componente"/><Button Grid.Column="1" Style="{StaticResource LimsSecondaryButtonStyle}" Click="OnRemove" Tag="{x:Bind}" AutomationProperties.Name="Quitar componente" Padding="8" MinWidth="32"><design:LimsIcon Icon="Delete" Size="16"/></Button></Grid>
         <TextBlock Text="{x:Bind IdentityDisplay, Mode=OneWay}" Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap"/>
         <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions><TextBox Text="{x:Bind Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LimsCompactTextBoxStyle}" PlaceholderText="Volumen tomado" AutomationProperties.Name="Volumen tomado del componente"/><design:LimsSelect Grid.Column="1" ItemsSource="{x:Bind Units}" SelectedItem="{x:Bind Unit, Mode=TwoWay}" AutomationProperties.Name="Unidad del volumen tomado"/></Grid>
         <TextBlock Text="{x:Bind BalanceDisplay, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
         <TextBlock Text="{x:Bind Error, Mode=OneWay}" Visibility="{x:Bind HasError, Mode=OneWay}" Style="{StaticResource LimsValidationTextStyle}"/>
        </StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Button x:Name="AddButton" Style="{StaticResource LimsSecondaryButtonStyle}" Click="OnAdd" HorizontalAlignment="Left" IsEnabled="{x:Bind ViewModel.CanAddComponent, Mode=OneWay}"><StackPanel Orientation="Horizontal" Spacing="8"><design:LimsIcon Icon="Preparations" Size="16"/><TextBlock Text="Agregar componente"/></StackPanel></Button>
      <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="Volumen de aforo" Style="{StaticResource LimsFormLabelStyle}"/><TextBox x:Name="FinalVolumeBox" Text="{x:Bind ViewModel.FinalVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LimsCompactTextBoxStyle}" PlaceholderText="Volumen final" AutomationProperties.Name="Volumen de aforo"/></StackPanel><design:LimsSelect Grid.Column="1" ItemsSource="{x:Bind ViewModel.VolumeUnits}" SelectedItem="{x:Bind ViewModel.FinalUnit, Mode=TwoWay}" VerticalAlignment="Bottom" AutomationProperties.Name="Unidad de aforo"/></Grid>
      <TextBlock Text="{x:Bind ViewModel.VolumeError, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasVolumeError, Mode=OneWay}" Style="{StaticResource LimsValidationTextStyle}"/>
     </StackPanel>
     <Border x:Name="ResultPanel" Grid.Column="1" Padding="16" Background="{ThemeResource LimsSurfaceSecondaryBrush}" CornerRadius="12" VerticalAlignment="Top">
      <StackPanel Spacing="10"><TextBlock Text="RESULTADO" Style="{StaticResource LimsSectionTitleStyle}"/><Grid ColumnSpacing="16" RowSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition x:Name="CylinderColumn" Width="*"/><ColumnDefinition x:Name="NumbersColumn" Width="0"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Viewbox Height="170" Stretch="Uniform"><local:GraduatedCylinder x:Name="Cylinder"/></Viewbox>
       <StackPanel x:Name="ResultNumbers" Grid.Row="1" Spacing="10" MaxWidth="440" HorizontalAlignment="Stretch">
       <Grid ColumnSpacing="8" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Volumen tomado total" Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TotalDisplay, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="Aforar hasta" Style="{StaticResource LimsCaptionStyle}" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.FinalDisplay, Mode=OneWay}" FontSize="18"/>
        <TextBlock Grid.Row="2" Text="Restante para aforo" Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.RemainingDisplay, Mode=OneWay}" FontSize="18"/>
       </Grid>
       <Border Height="1" Background="{ThemeResource LimsBorderBrush}"/>
       <TextBlock Text="Concentración por analito" Style="{StaticResource LimsCaptionStyle}"/><TextBlock x:Name="ResultText" Text="{x:Bind ViewModel.ResultDisplay, Mode=OneWay}" TextWrapping="Wrap"/>
       </StackPanel></Grid>
      </StackPanel>
     </Border>
    </Grid>
    <TextBox x:Name="NotesBox" Header="Observaciones" Text="{x:Bind ViewModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LimsCompactTextBoxStyle}" PlaceholderText="Observaciones de la preparación" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"/>
   </StackPanel></ContentControl>
  </ScrollViewer>
  <StackPanel x:Name="SuccessSurface" Visibility="Collapsed" Spacing="10"><design:StatusBadge Text="Intermedia creada" Tone="Success"/><TextBlock x:Name="SuccessCode" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="SuccessResult" TextWrapping="Wrap"/><TextBlock x:Name="SuccessCount" Style="{StaticResource LimsCaptionStyle}"/></StackPanel>
  <TextBlock Grid.Row="1" x:Name="MessageText" Text="{x:Bind ViewModel.Message, Mode=OneWay}" Style="{StaticResource LimsValidationTextStyle}"/>
  <Grid Grid.Row="2" BorderBrush="{ThemeResource LimsBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel x:Name="ConfirmSurface" Spacing="6" Visibility="Collapsed"><TextBlock x:Name="ConfirmText" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ConfirmButton" Content="Confirmar" Click="OnConfirm" Style="{StaticResource LimsPrimaryButtonStyle}"/><Button Content="Volver a editar" Click="OnDismissConfirmation" Style="{StaticResource LimsSecondaryButtonStyle}"/></StackPanel></StackPanel>
   <StackPanel x:Name="FooterActions" Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button x:Name="CancelButton" Content="Cancelar" Click="OnCancel" Style="{StaticResource LimsSecondaryButtonStyle}"/><Button x:Name="ViewButton" Content="Ver preparación" Click="OnViewCreated" Visibility="Collapsed" Style="{StaticResource LimsPrimaryButtonStyle}"/><Button x:Name="SaveButton" Content="Crear Intermedia" Click="OnSave" Style="{StaticResource LimsPrimaryButtonStyle}"/></StackPanel>
  </Grid>
 </Grid>
</ContentDialog>
