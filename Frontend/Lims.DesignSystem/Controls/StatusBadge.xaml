<UserControl
    x:Class="Lims.DesignSystem.Controls.StatusBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ToneStates">
                    <VisualState x:Name="Neutral" />
                    <VisualState x:Name="Success"><VisualState.Setters><Setter Target="Dot.Fill" Value="{ThemeResource LimsSuccessBrush}" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Warning"><VisualState.Setters><Setter Target="Dot.Fill" Value="{ThemeResource LimsWarningBrush}" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Danger"><VisualState.Setters><Setter Target="Dot.Fill" Value="{ThemeResource LimsDangerBrush}" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Information"><VisualState.Setters><Setter Target="Dot.Fill" Value="{ThemeResource LimsInformationBrush}" /></VisualState.Setters></VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border Padding="8,4" CornerRadius="6" Background="{ThemeResource LimsSurfaceSecondaryBrush}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse x:Name="Dot" Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource LimsTextSecondaryBrush}" />
                <TextBlock FontSize="12" Foreground="{ThemeResource LimsTextPrimaryBrush}" Text="{x:Bind Text, Mode=OneWay}" />
            </StackPanel>
            </Border>
    </Grid>
</UserControl>
