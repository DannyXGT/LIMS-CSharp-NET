<ContentDialog xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:design="using:Lims.DesignSystem.Controls" xmlns:local="using:Lims.Desktop.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Lims.Desktop.Views.StockEditorDialog" Style="{StaticResource LimsEditorDialogStyle}" Language="es-GT" Opened="OnOpened" Closing="OnClosing" Closed="OnClosed">
 <ContentDialog.Resources>
  <x:Double x:Key="ContentDialogMaxWidth">1800</x:Double>
  <x:Double x:Key="ContentDialogMaxHeight">1400</x:Double>
 </ContentDialog.Resources>
 <Grid x:Name="EditorRoot" RowSpacing="10">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" />
   <RowDefinition Height="Auto" />
   <RowDefinition Height="*" />
   <RowDefinition Height="Auto" />
   <RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <local:PreparationEditorHeader x:Name="EditorHeading" Heading="Nuevo Stock preparado" Description="Preparación en laboratorio · estándar, cantidades y composición" />
  <StackPanel Spacing="12" Grid.Row="1" Orientation="Horizontal">
   <TextBlock Text="Origen del Stock" Style="{StaticResource LimsFormLabelStyle}" VerticalAlignment="Center" />
   <design:LimsSelect x:Name="EntryTypeSelect" SelectionChanged="OnEntryTypeChanged" AutomationProperties.Name="Tipo de ingreso" Width="260" />
  </StackPanel>
  <StackPanel x:Name="SuccessSurface" Spacing="12" Visibility="Collapsed" Grid.Row="2">
   <design:StatusBadge Text="Stock creado" Tone="Success" HorizontalAlignment="Left" />
   <TextBlock x:Name="SuccessCode" FontSize="24" FontWeight="SemiBold" />
   <TextBlock x:Name="SuccessResult" />
   <TextBlock x:Name="SuccessConsumption" />
  </StackPanel>
  <TextBlock x:Name="MessageText" IsTextSelectionEnabled="True" Grid.Row="3" Text="{x:Bind ViewModel.Message, Mode=OneWay}" Style="{StaticResource LimsInlineErrorStyle}" TextWrapping="Wrap" />
  <Grid Grid.Row="4" Padding="0,12,0,0" BorderBrush="{ThemeResource LimsBorderBrush}" BorderThickness="0,1,0,0" x:Name="ActionBar">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
    <ColumnDefinition Width="Auto" />
   </Grid.ColumnDefinitions>
   <Button x:Name="CancelButton" Style="{StaticResource LimsActionButtonStyle}" Content="Cancelar" Click="OnCancel" HorizontalAlignment="Left" Grid.Column="1" Margin="0,0,10,0" />
   <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
    <Button x:Name="SaveButton" Style="{StaticResource LimsPrimaryActionStyle}" Content="Crear Stock" Click="OnSave" IsEnabled="False" />
    <Button design:LimsAction.Icon="ViewDetail" x:Name="ViewButton" Style="{StaticResource LimsUtilityActionStyle}" Content="Ver preparación" Click="OnViewCreated" Visibility="Collapsed" />
   </StackPanel>
   <TextBlock x:Name="FooterStatus" Style="{StaticResource LimsCaptionStyle}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
  </Grid>
  <Grid x:Name="LaboratoryLayout" Grid.Row="2" ColumnSpacing="16" RowSpacing="12">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="310" />
   </Grid.ColumnDefinitions>
   <Grid.RowDefinitions>
    <RowDefinition Height="*" />
    <RowDefinition Height="Auto" />
   </Grid.RowDefinitions>
   <ScrollViewer x:Name="StepScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="FormSurface" Spacing="10" Padding="2,2,12,8">
     <StackPanel Spacing="8">
      <TextBlock Text="ESTÁNDAR ORIGEN" Style="{StaticResource LimsSectionTitleStyle}" FontSize="13" />
      <design:LimsSearchSelect x:Name="SourceList" ItemsSource="{x:Bind ViewModel.Sources}" SelectedItem="{x:Bind ViewModel.SelectedSource, Mode=TwoWay}" PlaceholderText="Buscar nombre, CAS, catálogo o lote…" SearchPlaceholder="Buscar nombre, CAS, catálogo o lote…" SearchTextChanged="OnSourceSearchChanged" AutomationProperties.Name="Buscar estándar origen" />
      <Button x:Name="MoreSourcesButton" Content="Cargar más estándares" Click="OnMoreSources" Style="{StaticResource LimsUtilityActionStyle}" HorizontalAlignment="Left" Visibility="Collapsed" />
     </StackPanel>
     <Border x:Name="SourceCard" Padding="10" Background="{ThemeResource LimsSurfaceSecondaryBrush}" CornerRadius="10" Visibility="Collapsed">
      <StackPanel Spacing="3">
       <TextBlock Text="{x:Bind ViewModel.SelectedSource.Name, Mode=OneWay}" Style="{StaticResource LimsSectionTitleStyle}" TextWrapping="Wrap" FontSize="13" />
       <TextBlock x:Name="SourceIdentity" Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap" />
       <TextBlock x:Name="SourceContext" Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap" />
       <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*" />
         <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="SourceBalance" FontWeight="SemiBold" />
        <TextBlock Grid.Column="1" x:Name="SourceValidity" Style="{StaticResource LimsCaptionStyle}" />
       </Grid>
       <ProgressBar Value="{x:Bind ViewModel.SelectedSource.AvailabilityPercent, Mode=OneWay}" Maximum="100" />
      </StackPanel>
     </Border>
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="5">
       <TextBlock Text="Nombre" Style="{StaticResource LimsFormLabelStyle}" />
       <TextBox x:Name="NameBox" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LimsCompactTextBoxStyle}" PlaceholderText="Nombre del Stock" AutomationProperties.Name="Nombre del Stock" MaxLength="200" />
      </StackPanel>
      <StackPanel Spacing="5" Grid.Column="1">
       <TextBlock Text="Compuesto" Style="{StaticResource LimsFormLabelStyle}" />
       <TextBox x:Name="CompoundBox" Text="{x:Bind ViewModel.Compound, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LimsCompactTextBoxStyle}" PlaceholderText="Compuesto analítico" AutomationProperties.Name="Compuesto" MaxLength="200" />
      </StackPanel>
     </Grid>
     <TextBlock Text="PREPARACIÓN" Style="{StaticResource LimsSectionTitleStyle}" FontSize="13" />
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid ColumnSpacing="10">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="96" />
       </Grid.ColumnDefinitions>
       <StackPanel Spacing="5">
        <TextBlock Text="Concentración objetivo" Style="{StaticResource LimsFormLabelStyle}" />
        <TextBox x:Name="ConcentrationBox" Text="{x:Bind ViewModel.Concentration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LimsCompactTextBoxStyle}" PlaceholderText="Concentración objetivo" AutomationProperties.Name="Concentración objetivo" />
       </StackPanel>
       <StackPanel Grid.Column="1">
        <StackPanel Spacing="5">
         <TextBlock Text="Unidad" Style="{StaticResource LimsFormLabelStyle}" />
         <design:LimsSelect x:Name="ConcentrationUnitSelect" ItemsSource="{x:Bind ViewModel.ConcentrationUnits}" SelectedItem="{x:Bind ViewModel.ConcentrationUnit, Mode=TwoWay}" AutomationProperties.Name="Unidad de concentración" />
        </StackPanel>
       </StackPanel>
      </Grid>
      <Grid ColumnSpacing="10" Grid.Column="1">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="96" />
       </Grid.ColumnDefinitions>
       <StackPanel Spacing="5">
        <TextBlock Text="Volumen final" Style="{StaticResource LimsFormLabelStyle}" />
        <TextBox x:Name="FinalQuantityBox" Text="{x:Bind ViewModel.FinalVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LimsCompactTextBoxStyle}" PlaceholderText="Volumen final" AutomationProperties.Name="Volumen final" />
       </StackPanel>
       <StackPanel Grid.Column="1">
        <StackPanel Spacing="5">
         <TextBlock Text="Unidad" Style="{StaticResource LimsFormLabelStyle}" />
         <design:LimsSelect x:Name="VolumeUnitSelect" ItemsSource="{x:Bind ViewModel.FinalVolumeUnits}" SelectedItem="{x:Bind ViewModel.FinalVolumeUnit, Mode=TwoWay}" AutomationProperties.Name="Unidad de volumen" />
        </StackPanel>
       </StackPanel>
      </Grid>
     </Grid>
     <local:SolventCompositionEditor x:Name="CompositionEditor" />
     <Expander Header="Vigencia y almacenamiento" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
      <StackPanel Spacing="8">
       <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*" />
         <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="5">
         <TextBlock Text="Fecha preparación" Style="{StaticResource LimsFormLabelStyle}" />
         <design:LimsDatePicker x:Name="PreparationDatePicker" DateChanged="OnDateChanged" AutomationProperties.Name="Fecha de preparación" />
        </StackPanel>
        <StackPanel Grid.Column="1">
         <StackPanel Spacing="5">
          <TextBlock Text="Expiración" Style="{StaticResource LimsFormLabelStyle}" />
          <design:LimsDatePicker x:Name="ExpirationDatePicker" DateChanged="OnDateChanged" AutomationProperties.Name="Fecha de expiración" />
         </StackPanel>
        </StackPanel>
       </Grid>
       <StackPanel Spacing="5">
        <TextBlock Text="Temperatura de almacenamiento" Style="{StaticResource LimsFormLabelStyle}" />
        <TextBox x:Name="StorageTemperatureBox" Text="{x:Bind ViewModel.StorageTemperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LimsCompactTextBoxStyle}" PlaceholderText="Temperatura de almacenamiento" AutomationProperties.Name="Temperatura de almacenamiento" MaxLength="200" />
       </StackPanel>
      </StackPanel>
     </Expander>
    </StackPanel>
   </ScrollViewer>
   <Border x:Name="ResultPanel" Grid.Column="1" Padding="16" Background="{ThemeResource LimsAccentSoftBrush}" CornerRadius="10" VerticalAlignment="Stretch">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Spacing="12">
      <TextBlock Text="CÁLCULO DE PREPARACIÓN" Style="{StaticResource LimsSectionTitleStyle}" FontSize="13" />
      <StackPanel Spacing="5">
       <TextBlock Text="PESO REQUERIDO" Style="{StaticResource LimsCaptionStyle}" />
       <TextBlock x:Name="CalculatedWeightText" Text="—" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
      </StackPanel>
      <Grid ColumnSpacing="10">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="120" />
       </Grid.ColumnDefinitions>
       <StackPanel Spacing="5">
        <TextBlock Text="Peso tomado" Style="{StaticResource LimsFormLabelStyle}" />
        <TextBox x:Name="ActualQuantityBox" Text="{x:Bind ViewModel.ActualQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LimsCompactTextBoxStyle}" PlaceholderText="Peso tomado" AutomationProperties.Name="Peso tomado" />
       </StackPanel>
       <StackPanel Grid.Column="1">
        <StackPanel Spacing="5">
         <TextBlock Text="Unidad" Style="{StaticResource LimsFormLabelStyle}" />
         <design:LimsSelect x:Name="ActualUnitSelect" ItemsSource="{x:Bind ViewModel.WeightUnits}" SelectedItem="{x:Bind ViewModel.ActualWeightUnit, Mode=TwoWay}" AutomationProperties.Name="Unidad de peso tomado" />
        </StackPanel>
       </StackPanel>
      </Grid>
      <Grid ColumnSpacing="8" Padding="0,8,0,0" BorderBrush="{ThemeResource LimsBorderBrush}" BorderThickness="0,1,0,0">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
       </Grid.ColumnDefinitions>
       <TextBlock Text="Concentración real" Style="{StaticResource LimsCaptionStyle}" VerticalAlignment="Center" />
       <TextBlock x:Name="ActualConcentrationText" Text="—" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Grid.Column="1" MaxWidth="160" />
      </Grid>
      <Grid ColumnSpacing="8" Padding="0,8,0,0" BorderBrush="{ThemeResource LimsBorderBrush}" BorderThickness="0,1,0,0">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
       </Grid.ColumnDefinitions>
       <TextBlock Text="Diferencia" Style="{StaticResource LimsCaptionStyle}" VerticalAlignment="Center" />
       <TextBlock x:Name="DifferenceText" Text="—" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Grid.Column="1" MaxWidth="160" />
      </Grid>
      <Grid ColumnSpacing="8" Padding="0,8,0,0" BorderBrush="{ThemeResource LimsBorderBrush}" BorderThickness="0,1,0,0">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
       </Grid.ColumnDefinitions>
       <TextBlock Text="Saldo restante" Style="{StaticResource LimsCaptionStyle}" VerticalAlignment="Center" />
       <TextBlock x:Name="RemainingText" Text="—" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Grid.Column="1" MaxWidth="160" />
      </Grid>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <local:CommercialPreparationEditor x:Name="CommercialEntry" Visibility="Collapsed" Grid.Row="2" />
 </Grid>
</ContentDialog>