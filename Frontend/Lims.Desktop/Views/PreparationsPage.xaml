<Page x:Class="Lims.Desktop.Views.PreparationsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:design="using:Lims.DesignSystem.Controls" Background="Transparent" Language="es-GT">
 <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <design:LimsTabStrip x:Name="PreparationTabs" SelectionChanged="OnTabChanged" AutomationProperties.Name="Tipos de preparación">
   <design:LimsTabItem x:Name="StockTab" Label="Stock"/>
   <design:LimsTabItem x:Name="IntermediateTab" Label="Intermedia"/>
   <design:LimsTabItem x:Name="CurveTab" Label="Curva"/>
   <design:LimsTabItem x:Name="AqsTab" Label="AQS"/>
  </design:LimsTabStrip>
  <ContentControl x:Name="PreparationHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
 </Grid>
</Page>
