<Page x:Class="Lims.Desktop.Views.DashboardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource LimsBackgroundBrush}">
    <Grid RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="3"><TextBlock x:Name="Welcome" FontSize="21" FontWeight="SemiBold" Text="Su laboratorio, de un vistazo" TextWrapping="Wrap"/><TextBlock x:Name="Identity" Foreground="{ThemeResource LimsTextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="Actualizar" AutomationProperties.Name="Actualizar dashboard" Style="{StaticResource LimsSecondaryButtonStyle}" Click="OnRefresh" VerticalAlignment="Center"/>
        </Grid>
        <ScrollViewer x:Name="DashboardScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentStack" Spacing="16" Padding="0,6,4,16">
                <ProgressBar x:Name="LoadingIndicator" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="Consultando dashboard"/>
                <InfoBar x:Name="ErrorBar" IsClosable="False" Severity="Error" Title="Datos no disponibles"/>
                <StackPanel x:Name="EmptyPanel" Visibility="Collapsed"/>
                <Grid x:Name="MetricsGrid" RowSpacing="12" ColumnSpacing="12"/>
                <Grid x:Name="OverviewGrid" RowSpacing="16" ColumnSpacing="16"/>
                <Grid x:Name="OperationsGrid" RowSpacing="16" ColumnSpacing="16"/>
                <StackPanel x:Name="QuickPanel" Spacing="10"/>
                <TextBlock x:Name="Timestamp" FontSize="11" Foreground="{ThemeResource LimsTextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
