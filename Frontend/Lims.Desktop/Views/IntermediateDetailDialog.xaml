<ContentDialog x:Class="Lims.Desktop.Views.IntermediateDetailDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:design="using:Lims.DesignSystem.Controls" xmlns:local="using:Lims.Desktop.Views" xmlns:contracts="using:Lims.Contracts.ReferencePreparations"
 Style="{StaticResource LimsEditorDialogStyle}" Title="Solución intermedia" CloseButtonText="Cerrar" Language="es-GT" Opened="OnOpened" Closed="OnClosed">
 <ContentDialog.Resources><x:Double x:Key="ContentDialogMaxWidth">1080</x:Double></ContentDialog.Resources>
 <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel x:Name="DetailSurface" Spacing="16" Padding="4,2,12,8">
   <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="{x:Bind Detail.Preparation.Code}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Detail.Preparation.Name}" FontSize="18" TextWrapping="Wrap"/><TextBlock Text="{x:Bind ContextDisplay}" Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap"/></StackPanel><design:StatusBadge Grid.Column="1" Text="{x:Bind Detail.Preparation.StatusLabel}" Tone="{x:Bind Detail.Preparation.StatusTone}" VerticalAlignment="Top"/></Grid>
   <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="VOLUMEN FINAL" Style="{StaticResource LimsCaptionStyle}"/><TextBlock Text="{x:Bind Detail.Preparation.FinalDisplay}" FontSize="22" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="COMPONENTES" Style="{StaticResource LimsCaptionStyle}"/><TextBlock Text="{x:Bind Detail.Preparation.ComponentCount}" FontSize="22" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="DISPONIBLE" Style="{StaticResource LimsCaptionStyle}"/><TextBlock Text="{x:Bind Detail.Preparation.AvailableDisplay}" FontSize="22" FontWeight="SemiBold"/></StackPanel></Grid>
   <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:GraduatedCylinder x:Name="Cylinder"/><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="CONCENTRACIÓN POR ANALITO" Style="{StaticResource LimsSectionTitleStyle}"/><ItemsControl ItemsSource="{x:Bind Detail.Preparation.Results}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="contracts:IntermediateAnalyte"><TextBlock Text="{x:Bind Display}" TextWrapping="Wrap" Margin="0,0,0,6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{x:Bind VolumeDisplay}" Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind ExpirationDisplay}" Style="{StaticResource LimsCaptionStyle}"/></StackPanel></Grid>
   <TextBlock Text="COMPONENTES Y TRAZABILIDAD" Style="{StaticResource LimsSectionTitleStyle}"/>
   <Grid ColumnSpacing="12" Padding="8" Background="{ThemeResource LimsSurfaceSecondaryBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Origen" Style="{StaticResource LimsFormLabelStyle}"/><TextBlock Grid.Column="1" Text="Tipo" Style="{StaticResource LimsFormLabelStyle}"/><TextBlock Grid.Column="2" Text="Tomado" Style="{StaticResource LimsFormLabelStyle}"/><TextBlock Grid.Column="3" Text="Concentración origen" Style="{StaticResource LimsFormLabelStyle}"/></Grid>
   <ItemsControl ItemsSource="{x:Bind Detail.Calculation.Components}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="contracts:IntermediateContribution"><Grid ColumnSpacing="12" Padding="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Style="{StaticResource LimsSecondaryButtonStyle}" Content="{x:Bind Source.Code}" ToolTipService.ToolTip="{x:Bind Source.Name}" Click="OnSourceClick" Tag="{x:Bind Source}" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="{x:Bind Source.KindLabel}"/><TextBlock Grid.Column="2" Text="{x:Bind TakenDisplay}"/><TextBlock Grid.Column="3" Text="{x:Bind Source.ConcentrationDisplay}" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="CONSUMOS REGISTRADOS" Style="{StaticResource LimsSectionTitleStyle}"/><ItemsControl ItemsSource="{x:Bind Detail.Consumptions}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="contracts:IntermediateConsumption"><TextBlock Text="{x:Bind Display}" TextWrapping="Wrap" Margin="8,0,0,6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="AUDITORÍA" Style="{StaticResource LimsSectionTitleStyle}"/><TextBlock Text="{x:Bind AuditDisplay}" Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Detail.NotesDisplay}" TextWrapping="Wrap"/>
  </StackPanel>
 </ScrollViewer>
</ContentDialog>
