<ContentDialog xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:design="using:Lims.DesignSystem.Controls" x:Class="Lims.Desktop.Views.StockEditorDialog" Style="{StaticResource LimsEditorDialogStyle}" Title="Nueva preparación Stock" Language="es-GT" Opened="OnOpened" Closing="OnClosing" Closed="OnClosed">
 <ContentDialog.Resources>
  <x:Double x:Key="ContentDialogMaxWidth">1080</x:Double>
  <x:Double x:Key="ContentDialogMaxHeight">1000</x:Double>
 </ContentDialog.Resources>
 <Grid x:Name="EditorRoot" RowSpacing="12">
  <Grid.RowDefinitions>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <ScrollViewer x:Name="StepScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="FormSurface" Spacing="12" Padding="2,2,12,8">
    <StackPanel Spacing="8">
     <TextBlock Text="ESTÁNDAR ORIGEN" Style="{StaticResource LimsSectionTitleStyle}"/>
     <design:LimsSearchSelect x:Name="SourceList" ItemsSource="{x:Bind ViewModel.Sources}" SelectedItem="{x:Bind ViewModel.SelectedSource, Mode=TwoWay}" PlaceholderText="Buscar nombre, CAS, catálogo o lote…" SearchPlaceholder="Buscar nombre, CAS, catálogo o lote…" SearchTextChanged="OnSourceSearchChanged" AutomationProperties.Name="Buscar estándar origen"/>
     <Button x:Name="MoreSourcesButton" Content="Cargar más estándares" Click="OnMoreSources" Style="{StaticResource LimsSecondaryButtonStyle}" HorizontalAlignment="Left" Visibility="Collapsed"/>
    </StackPanel>
    <Border x:Name="SourceCard" Padding="12" Background="{ThemeResource LimsSurfaceSecondaryBrush}" CornerRadius="10" Visibility="Collapsed">
     <StackPanel Spacing="5">
      <TextBlock Text="{x:Bind ViewModel.SelectedSource.Name, Mode=OneWay}" Style="{StaticResource LimsSectionTitleStyle}" TextWrapping="Wrap"/>
      <TextBlock x:Name="SourceIdentity" Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap"/>
      <TextBlock x:Name="SourceContext" Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap"/>
      <Grid ColumnSpacing="12">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <TextBlock x:Name="SourceBalance" FontWeight="SemiBold"/>
       <TextBlock Grid.Column="1" x:Name="SourceValidity" Style="{StaticResource LimsCaptionStyle}"/>
      </Grid>
      <ProgressBar Value="{x:Bind ViewModel.SelectedSource.AvailabilityPercent, Mode=OneWay}" Maximum="100"/>
     </StackPanel>
    </Border>
    <Grid x:Name="PreparationGrid" ColumnSpacing="20" RowSpacing="16">
     <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="PreparationColumn" Width="*"/>
      <ColumnDefinition x:Name="ResultColumn" Width="*"/>
     </Grid.ColumnDefinitions>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <StackPanel x:Name="PreparationPanel" Spacing="8">
      <TextBlock Text="PREPARACIÓN" Style="{StaticResource LimsSectionTitleStyle}"/>
      <StackPanel Spacing="5">
       <TextBlock Text="Nombre" Style="{StaticResource LimsFormLabelStyle}"/>
       <TextBox x:Name="NameBox" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LimsCompactTextBoxStyle}" PlaceholderText="Nombre del Stock" AutomationProperties.Name="Nombre del Stock" MaxLength="200"/>
      </StackPanel>
      <Grid ColumnSpacing="10">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="120"/>
       </Grid.ColumnDefinitions>
       <StackPanel Spacing="5">
        <TextBlock Text="Concentración objetivo" Style="{StaticResource LimsFormLabelStyle}"/>
        <TextBox x:Name="ConcentrationBox" Text="{x:Bind ViewModel.Concentration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LimsCompactTextBoxStyle}" PlaceholderText="Concentración objetivo" AutomationProperties.Name="Concentración objetivo"/>
       </StackPanel>
       <StackPanel Grid.Column="1">
        <StackPanel Spacing="5">
         <TextBlock Text="Unidad" Style="{StaticResource LimsFormLabelStyle}"/>
         <design:LimsSelect x:Name="ConcentrationUnitSelect" ItemsSource="{x:Bind ViewModel.ConcentrationUnits}" SelectedItem="{x:Bind ViewModel.ConcentrationUnit, Mode=TwoWay}" AutomationProperties.Name="Unidad de concentración"/>
        </StackPanel>
       </StackPanel>
      </Grid>
      <Grid ColumnSpacing="10">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="120"/>
       </Grid.ColumnDefinitions>
       <StackPanel Spacing="5">
        <TextBlock Text="Volumen final" Style="{StaticResource LimsFormLabelStyle}"/>
        <TextBox x:Name="FinalQuantityBox" Text="{x:Bind ViewModel.FinalVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LimsCompactTextBoxStyle}" PlaceholderText="Volumen final" AutomationProperties.Name="Volumen final"/>
       </StackPanel>
       <StackPanel Grid.Column="1">
        <StackPanel Spacing="5">
         <TextBlock Text="Unidad" Style="{StaticResource LimsFormLabelStyle}"/>
         <design:LimsSelect x:Name="VolumeUnitSelect" ItemsSource="{x:Bind ViewModel.FinalVolumeUnits}" SelectedItem="{x:Bind ViewModel.FinalVolumeUnit, Mode=TwoWay}" AutomationProperties.Name="Unidad de volumen"/>
        </StackPanel>
       </StackPanel>
      </Grid>
      <Grid ColumnSpacing="10">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <StackPanel Spacing="5">
        <TextBlock Text="Fecha preparación" Style="{StaticResource LimsFormLabelStyle}"/>
        <design:LimsDatePicker x:Name="PreparationDatePicker" DateChanged="OnDateChanged" AutomationProperties.Name="Fecha de preparación"/>
       </StackPanel>
       <StackPanel Grid.Column="1">
        <StackPanel Spacing="5">
         <TextBlock Text="Expiración" Style="{StaticResource LimsFormLabelStyle}"/>
         <design:LimsDatePicker x:Name="ExpirationDatePicker" DateChanged="OnDateChanged" AutomationProperties.Name="Fecha de expiración"/>
        </StackPanel>
       </StackPanel>
      </Grid>
      <StackPanel Spacing="5">
       <TextBlock Text="Temperatura de almacenamiento" Style="{StaticResource LimsFormLabelStyle}"/>
       <TextBox x:Name="StorageTemperatureBox" Text="{x:Bind ViewModel.StorageTemperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LimsCompactTextBoxStyle}" PlaceholderText="Temperatura de almacenamiento" AutomationProperties.Name="Temperatura de almacenamiento" MaxLength="200"/>
      </StackPanel>
      <StackPanel Spacing="5">
       <TextBlock Text="Observaciones" Style="{StaticResource LimsFormLabelStyle}"/>
       <TextBox x:Name="NotesBox" Text="{x:Bind ViewModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LimsCompactTextBoxStyle}" PlaceholderText="Observaciones" AutomationProperties.Name="Observaciones" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50"/>
      </StackPanel>
     </StackPanel>
     <Border x:Name="ResultPanel" Grid.Column="1" Padding="20" Background="{ThemeResource LimsAccentSoftBrush}" CornerRadius="10" VerticalAlignment="Top">
      <StackPanel Spacing="12">
       <TextBlock Text="RESULTADO" Style="{StaticResource LimsSectionTitleStyle}"/>
       <StackPanel Spacing="5">
        <TextBlock Text="PESO A TOMAR" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock x:Name="CalculatedWeightText" Text="—" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
       <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="120"/>
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="5">
         <TextBlock Text="Peso tomado" Style="{StaticResource LimsFormLabelStyle}"/>
         <TextBox x:Name="ActualQuantityBox" Text="{x:Bind ViewModel.ActualQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LimsCompactTextBoxStyle}" PlaceholderText="Peso tomado" AutomationProperties.Name="Peso tomado"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
         <StackPanel Spacing="5">
          <TextBlock Text="Unidad" Style="{StaticResource LimsFormLabelStyle}"/>
          <design:LimsSelect x:Name="ActualUnitSelect" ItemsSource="{x:Bind ViewModel.WeightUnits}" SelectedItem="{x:Bind ViewModel.ActualWeightUnit, Mode=TwoWay}" AutomationProperties.Name="Unidad de peso tomado"/>
         </StackPanel>
        </StackPanel>
       </Grid>
       <TextBlock Text="Registre el peso efectivamente medido para crear el Stock." Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap"/>
       <StackPanel Spacing="5">
        <TextBlock Text="CONCENTRACIÓN REAL" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock x:Name="ActualConcentrationText" Text="—" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
       <StackPanel Spacing="5">
        <TextBlock Text="DIFERENCIA RESPECTO AL OBJETIVO" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock x:Name="DifferenceText" Text="—" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
       <StackPanel Spacing="5">
        <TextBlock Text="SALDO DESPUÉS" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock x:Name="RemainingText" Text="—" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
     </Border>
    </Grid>
   </StackPanel>
  </ScrollViewer>
  <StackPanel x:Name="SuccessSurface" Spacing="12" Visibility="Collapsed">
   <design:StatusBadge Text="Stock creado" Tone="Success" HorizontalAlignment="Left"/>
   <TextBlock x:Name="SuccessCode" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock x:Name="SuccessResult"/>
   <TextBlock x:Name="SuccessConsumption"/>
  </StackPanel>
  <TextBlock x:Name="MessageText" Grid.Row="1" Text="{x:Bind ViewModel.Message, Mode=OneWay}" Style="{StaticResource LimsInlineErrorStyle}" TextWrapping="Wrap"/>
  <Grid Grid.Row="2" Padding="0,12,0,0" BorderBrush="{ThemeResource LimsBorderBrush}" BorderThickness="0,1,0,0">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <Button x:Name="CancelButton" Style="{StaticResource LimsSecondaryButtonStyle}" Content="Cancelar" Click="OnCancel" HorizontalAlignment="Left"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
    <Button x:Name="SaveButton" Style="{StaticResource LimsPrimaryButtonStyle}" Content="Crear Stock" Click="OnSave" IsEnabled="False"/>
    <Button x:Name="ViewButton" Style="{StaticResource LimsPrimaryButtonStyle}" Content="Ver preparación" Click="OnViewCreated" Visibility="Collapsed"/>
   </StackPanel>
  </Grid>
 </Grid>
</ContentDialog>
