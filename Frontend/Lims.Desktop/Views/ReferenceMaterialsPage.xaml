<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lims.Desktop.Views.ReferenceMaterialsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contracts="using:Lims.Contracts.ReferenceMaterials"
    xmlns:design="using:Lims.DesignSystem.Controls"
    Background="Transparent"
    Loaded="OnLoaded"
    SizeChanged="OnPageSizeChanged">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="12" Background="{ThemeResource LimsSurfaceBrush}" BorderBrush="{ThemeResource LimsBorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid x:Name="FilterGrid" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SearchFilterColumn" Width="2*" MinWidth="240" />
                    <ColumnDefinition x:Name="StatusFilterColumn" Width="150" />
                    <ColumnDefinition x:Name="MethodFilterColumn" Width="170" />
                    <ColumnDefinition x:Name="ApplyFilterColumn" Width="Auto" />
                    <ColumnDefinition x:Name="ClearFilterColumn" Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    design:LimsIcon.NavigationIcon="Search"
                    Style="{StaticResource LimsCompactSearchStyle}"
                    MinHeight="36"
                    VerticalAlignment="Bottom"
                    PlaceholderText="Buscar por nombre, CAS, catálogo, lote o marca"
                    AutomationProperties.Name="Buscar estándares"
                    QuerySubmitted="OnSearchSubmitted"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox x:Name="StatusCombo" Grid.Column="1" Header="Estado" Style="{StaticResource LimsCompactComboBoxStyle}" AutomationProperties.Name="Estado" SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="Todos" Tag="" IsSelected="True" />
                    <ComboBoxItem Content="Activo" Tag="Active" />
                    <ComboBoxItem Content="Agotado" Tag="Depleted" />
                    <ComboBoxItem Content="Vencido" Tag="Expired" />
                    <ComboBoxItem Content="Bloqueado" Tag="Blocked" />
                    <ComboBoxItem Content="Reemplazado" Tag="Replaced" />
                    <ComboBoxItem Content="Archivado" Tag="Archived" />
                    <ComboBoxItem Content="Retirado" Tag="Retired" />
                </ComboBox>
                <StackPanel x:Name="MethodFilterField" Grid.Column="2" Spacing="4">
                    <TextBlock Text="Método" FontSize="14" />
                    <design:LimsSearchSelect x:Name="MethodBox" PlaceholderText="Todos" SearchPlaceholder="Buscar método..." ItemsSource="{x:Bind ViewModel.Methods}" DisplayMemberPath="Name" AutomationProperties.Name="Filtrar por método" SelectionChanged="OnMethodChanged" />
                </StackPanel>
                <Button x:Name="ApplyFiltersButton" Grid.Column="3" VerticalAlignment="Bottom" Click="OnApplyFiltersClick" Content="Aplicar" Style="{StaticResource LimsStandardsSecondaryButtonStyle}" AutomationProperties.Name="Aplicar filtros" />
                <Button x:Name="ClearFiltersButton" Grid.Column="4" VerticalAlignment="Bottom" AutomationProperties.Name="Limpiar filtros" Style="{StaticResource LimsIconButtonStyle}" Click="OnClearFiltersClick" ToolTipService.ToolTip="Limpiar filtros">
                    <design:LimsIcon Icon="ClearFilters" Size="{StaticResource IconSizeSmall}" />
                </Button>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Spacing="6">
            <InfoBar
                x:Name="CatalogLoadingBar"
                IsClosable="False"
                IsOpen="False"
                Message="Cargando métodos, unidades y ubicaciones..."
                Severity="Informational" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasCatalogMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.CatalogMessage, Mode=OneWay}"
                Severity="Warning" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                Severity="Warning" />
        </StackPanel>

        <Grid x:Name="WorkspaceGrid" Grid.Row="2" ColumnSpacing="14" RowSpacing="0">
            <Border
                x:Name="TableBorder"
                SizeChanged="OnTableSizeChanged"
                Background="{ThemeResource LimsSurfaceBrush}"
                BorderBrush="{ThemeResource LimsBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid x:Name="TableGrid" MinWidth="1080">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="12,0" Background="{ThemeResource LimsSurfaceSecondaryBrush}" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="150" />
                            <ColumnDefinition Width="*" MinWidth="85" />
                            <ColumnDefinition Width="*" MinWidth="85" />
                            <ColumnDefinition Width="*" MinWidth="85" />
                            <ColumnDefinition Width="*" MinWidth="110" />
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="94" />
                            <ColumnDefinition Width="98" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource LimsTableHeadingStyle}" Text="Nombre / CAS" />
                        <TextBlock Grid.Column="1" Style="{StaticResource LimsTableHeadingStyle}" Text="Catálogo" />
                        <TextBlock Grid.Column="2" Style="{StaticResource LimsTableHeadingStyle}" Text="Lote" />
                        <TextBlock Grid.Column="3" Style="{StaticResource LimsTableHeadingStyle}" Text="Marca" />
                        <TextBlock Grid.Column="4" Style="{StaticResource LimsTableHeadingStyle}" Text="Método" />
                        <TextBlock Grid.Column="5" Style="{StaticResource LimsTableHeadingStyle}" Text="Pureza" />
                        <TextBlock Grid.Column="6" Style="{StaticResource LimsTableHeadingStyle}" Text="Expiración" />
                        <TextBlock Grid.Column="7" Style="{StaticResource LimsTableHeadingStyle}" Text="Estado" />
                        <TextBlock Grid.Column="8" Style="{StaticResource LimsTableHeadingStyle}" Text="Disponible" />
                    </Grid>

                    <ListView
                        x:Name="MaterialsList"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Items}"
                        SelectedItem="{x:Bind ViewModel.SelectedMaterial, Mode=TwoWay}"
                        ItemContainerStyle="{StaticResource LimsDataRowStyle}" AutomationProperties.Name="Estándares" SelectionChanged="OnMaterialSelected" ContainerContentChanging="OnRowContainerChanging">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="contracts:ReferenceMaterialSummary">
                                <Grid MinHeight="56" Padding="8,5" ColumnSpacing="8" DoubleTapped="OnRowDoubleTapped" Loaded="OnRowLoaded" SizeChanged="OnRowSizeChanged" ToolTipService.ToolTip="Doble clic para ver detalles; Enter sobre la fila seleccionada">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" MinWidth="150" />
                                        <ColumnDefinition Width="*" MinWidth="85" />
                                        <ColumnDefinition Width="*" MinWidth="85" />
                                        <ColumnDefinition Width="*" MinWidth="85" />
                                        <ColumnDefinition Width="*" MinWidth="110" />
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="94" />
                                        <ColumnDefinition Width="98" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="RowSelectionMarker" Grid.ColumnSpan="9" Width="2" Margin="-8,0,0,0" HorizontalAlignment="Left" Background="{ThemeResource LimsAccentBrush}" CornerRadius="1" Opacity="0" IsHitTestVisible="False" />
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind NameDisplay}" ToolTipService.ToolTip="{x:Bind NameDisplay}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource LimsCaptionStyle}" Text="{x:Bind CasDisplay}" ToolTipService.ToolTip="{x:Bind CasDisplay}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind CatalogDisplay}" ToolTipService.ToolTip="{x:Bind CatalogDisplay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind LotDisplay}" ToolTipService.ToolTip="{x:Bind LotDisplay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind BrandDisplay}" ToolTipService.ToolTip="{x:Bind BrandDisplay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{x:Bind Method}" ToolTipService.ToolTip="{x:Bind Method}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="5" VerticalAlignment="Center" Text="{x:Bind PurityDisplay}" ToolTipService.ToolTip="{x:Bind PurityDisplay}" />
                                    <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="{x:Bind ExpirationDisplay}" ToolTipService.ToolTip="{x:Bind ExpirationDisplay}" />
                                    <design:StatusBadge Grid.Column="7" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{x:Bind StatusLabel}" Tone="{x:Bind StatusTone}" />
                                    <StackPanel Grid.Column="8" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind AvailableDisplay}" ToolTipService.ToolTip="{x:Bind AvailableDisplay}" TextTrimming="CharacterEllipsis" />
                                        <Grid x:Name="RowAvailability" ColumnSpacing="5" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <ProgressBar x:Name="RowProgress" Height="3" Minimum="0" Maximum="100" Foreground="{ThemeResource LimsAccentBrush}" AutomationProperties.Name="Porcentaje disponible" />
                                            <TextBlock x:Name="RowPercent" Grid.Column="1" FontSize="10" Foreground="{ThemeResource LimsTextSecondaryBrush}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        Grid.Row="1"
                        MaxWidth="340"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="7"
                        Visibility="{x:Bind ViewModel.HasNoItems, Mode=OneWay}">
                        <design:LimsIcon Icon="ViewDetail" Size="{StaticResource IconSizeLarge}" Foreground="{ThemeResource LimsTextTertiaryBrush}" />
                        <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="No hay estándares registrados" />
                        <TextBlock TextAlignment="Center" Style="{StaticResource LimsCaptionStyle}" Text="Cree el primer estándar para comenzar." />
                        <Button HorizontalAlignment="Center" Margin="0,4,0,0" Click="OnCreateClick" Content="Nuevo estándar" Style="{StaticResource LimsPrimaryButtonStyle}" IsEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}" />
                    </StackPanel>

                </Grid>
                </ScrollViewer>
                    <Grid Grid.Row="1" Padding="12,7" Background="{ThemeResource LimsSurfaceSecondaryBrush}" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="85" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource LimsCaptionStyle}" Text="{x:Bind ViewModel.PaginationText, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource LimsCaptionStyle}" Text="Doble clic o Enter para ver la ficha" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource LimsIconButtonStyle}" Click="OnPreviousPageClick" IsEnabled="{x:Bind ViewModel.CanGoToPreviousPage, Mode=OneWay}" ToolTipService.ToolTip="Página anterior" AutomationProperties.Name="Página anterior">
                            <design:LimsIcon Icon="ChevronLeft" Size="{StaticResource IconSizeSmall}" />
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource LimsIconButtonStyle}" Click="OnNextPageClick" IsEnabled="{x:Bind ViewModel.CanGoToNextPage, Mode=OneWay}" ToolTipService.ToolTip="Página siguiente" AutomationProperties.Name="Página siguiente">
                            <design:LimsIcon Icon="ChevronRight" Size="{StaticResource IconSizeSmall}" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>

        </Grid>

        <Border x:Name="LoadingPlaceholder" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,54,16,0" Padding="16" Background="{ThemeResource LimsSurfaceBrush}" CornerRadius="6" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.Name="Cargando estándares">
            <StackPanel Spacing="12">
                <ProgressBar Width="260" Height="2" IsIndeterminate="True" />
                <Border Width="260" Height="8" Background="{ThemeResource LimsSurfaceSecondaryBrush}" CornerRadius="4" />
                <Border Width="220" Height="8" HorizontalAlignment="Left" Background="{ThemeResource LimsSurfaceSecondaryBrush}" CornerRadius="4" />
                <Border Width="180" Height="8" HorizontalAlignment="Left" Background="{ThemeResource LimsSurfaceSecondaryBrush}" CornerRadius="4" />
                <TextBlock Style="{StaticResource LimsCaptionStyle}" Text="Cargando estándares…" />
            </StackPanel>
        </Border>
        <ProgressBar x:Name="DelayedProgress" Grid.Row="2" Height="2" VerticalAlignment="Top" IsIndeterminate="True" Visibility="Collapsed" IsHitTestVisible="False" />
    </Grid>
</Page>
