<Page x:Class="Lims.Desktop.Views.PermissionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="using:Lims.DesignSystem.Controls"
    xmlns:local="using:Lims.Desktop.Controls"
    xmlns:motion="using:Lims.DesignSystem.Presentation"
    Background="Transparent" SizeChanged="OnPageSizeChanged">
    <Page.Resources>
        <Style x:Key="PermissionActionStyle" TargetType="local:PermissionAction">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource LimsFocusBrush}"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:PermissionAction">
                <Grid x:Name="Root" Background="{ThemeResource LimsSurfaceSecondaryBrush}" CornerRadius="7" Control.IsTemplateFocusTarget="True">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"/>
                            <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="PressedSurface.Opacity" Value="0.12"/></VisualState.Setters></VisualState>
                            <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.45"/></VisualState.Setters></VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="CheckStates"><VisualState x:Name="Checked"/><VisualState x:Name="Unchecked"/><VisualState x:Name="Indeterminate"/></VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border x:Name="SelectionSurface" CornerRadius="7" Background="{ThemeResource LimsAccentSoftBrush}" BorderBrush="{ThemeResource LimsAccentBrush}" BorderThickness="1" IsHitTestVisible="False"/>
                    <Border x:Name="HoverSurface" CornerRadius="7" Background="{ThemeResource LimsTextPrimaryBrush}" Opacity="0" IsHitTestVisible="False"/>
                    <Border x:Name="PressedSurface" CornerRadius="7" Background="{ThemeResource LimsTextPrimaryBrush}" Opacity="0" IsHitTestVisible="False"/>
                    <Grid Padding="11,10" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="7" VerticalAlignment="Center">
                            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{ThemeResource LimsTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SelectionText" Text="Sin asignar" FontSize="11"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="18" Height="18" VerticalAlignment="Top" CornerRadius="9" BorderBrush="{ThemeResource LimsBorderStrongBrush}" BorderThickness="1">
                            <TextBlock x:Name="CheckMark" Text="✓" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource LimsAccentBrush}"/>
                        </Border>
                    </Grid>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PermissionUserContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource LimsFocusBrush}"/>
        </Style>
    </Page.Resources>
    <Grid x:Name="ConsoleRoot" RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <InfoBar x:Name="Feedback" IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}" IsClosable="False" Message="{x:Bind ViewModel.Message, Mode=OneWay}" AutomationProperties.LiveSetting="Polite"/>
        <Grid x:Name="Panels" Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="UsersColumn" Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="UsersPanel" Padding="12,14,12,10" Background="{ThemeResource LimsSurfaceBrush}" CornerRadius="{StaticResource LimsSurfaceCornerRadius}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Padding="4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4"><TextBlock Text="Usuarios" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Laboratorio Analítico" Style="{StaticResource LimsCaptionStyle}"/></StackPanel>
                        <Button x:Name="RefreshUsersButton" Grid.Column="1" Style="{StaticResource LimsSecondaryButtonStyle}" Padding="8" Click="OnRefreshUsers" AutomationProperties.Name="Actualizar lista de usuarios" ToolTipService.ToolTip="Actualizar usuarios"><design:LimsIcon Icon="Replace" Size="16"/></Button>
                    </Grid>
                    <AutoSuggestBox x:Name="UserSearch" Grid.Row="1" design:LimsIcon.NavigationIcon="Search" PlaceholderText="Nombre o correo" Text="{x:Bind ViewModel.Search, Mode=TwoWay}" QuerySubmitted="OnSearch" AutomationProperties.Name="Buscar usuarios por nombre o correo"/>
                    <ListView x:Name="UsersList" Grid.Row="2" ItemsSource="{x:Bind ViewModel.UserRows}" ItemContainerStyle="{StaticResource PermissionUserContainerStyle}" SelectionMode="Single" SelectionChanged="OnUserChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Usuarios de Laboratorio Analítico">
                        <ListView.Resources>
                            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent"/>
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent"/>
                        </ListView.Resources>
                        <ListView.ItemTemplate><DataTemplate><local:PermissionUserItem Row="{Binding}"/></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="3" Margin="4,0" Text="{x:Bind ViewModel.UserCountLabel, Mode=OneWay}" Style="{StaticResource LimsCaptionStyle}"/>
                </Grid>
            </Border>
            <Border x:Name="DetailPanel" Grid.Column="1" Background="{ThemeResource LimsSurfaceBrush}" CornerRadius="{StaticResource LimsSurfaceCornerRadius}">
                <Grid>
                    <StackPanel x:Name="EmptySelection" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="340" Margin="24">
                        <design:LimsIcon Icon="Administration" Size="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="Seleccione un usuario" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Consulte sus permisos individuales y el historial de cambios desde esta consola." Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                    <Grid x:Name="UserWorkspace" Padding="20,16,20,14" RowSpacing="12" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid x:Name="UserHeader" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="22" Background="{ThemeResource LimsAccentSoftBrush}" VerticalAlignment="Top"><TextBlock Text="{x:Bind ViewModel.SelectedInitials, Mode=OneWay}" Foreground="{ThemeResource LimsAccentBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="{x:Bind ViewModel.SelectedUser.Name, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4"><TextBlock Text="{x:Bind ViewModel.SelectedUser.Email, Mode=OneWay}" Style="{StaticResource LimsCaptionStyle}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.SelectedUser.Email, Mode=OneWay}"/><TextBlock x:Name="IdentityMeta" Style="{StaticResource LimsCaptionStyle}" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                                    <design:StatusBadge Grid.Column="1" Text="{x:Bind ViewModel.ConfigurationLabel, Mode=OneWay}" Tone="{x:Bind ViewModel.ConfigurationTone, Mode=OneWay}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <design:LimsTabStrip x:Name="PermissionTabs" Grid.Row="1" SelectionChanged="OnTabChanged" AutomationProperties.Name="Vistas de permisos">
                            <design:LimsTabItem Label="Permisos" Icon="Lock"/>
                            <design:LimsTabItem Label="Historial de cambios" Icon="Traceability"/>
                        </design:LimsTabStrip>
                        <Grid Grid.Row="2" x:Name="TabContent">
                            <ScrollViewer x:Name="PermissionScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                                <StackPanel Spacing="18">
                                    <Grid x:Name="PermissionSummary" ColumnSpacing="16" Padding="0,2,0,8" BorderBrush="{ThemeResource LimsBorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="5"><TextBlock Text="ASIGNACIÓN INDIVIDUAL" FontSize="10" Foreground="{ThemeResource LimsTextTertiaryBrush}" CharacterSpacing="70"/><TextBlock Text="{x:Bind ViewModel.SavedSummary, Mode=OneWay}" FontSize="13" TextWrapping="Wrap"/></StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="ACCESO GUARDADO" FontSize="10" Foreground="{ThemeResource LimsTextTertiaryBrush}" CharacterSpacing="70"/><TextBlock Text="{x:Bind ViewModel.ModuleSummary, Mode=OneWay}" FontSize="13" TextWrapping="Wrap"/></StackPanel>
                                    </Grid>
                                    <ItemsControl x:Name="Matrix" ItemsSource="{x:Bind ViewModel.Groups}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <StackPanel Spacing="10" Margin="0,0,0,20">
                                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <design:LimsIcon Icon="{Binding Icon}" Size="18"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Summary}" Style="{StaticResource LimsCaptionStyle}" FontSize="11"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:PermissionActionPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate><DataTemplate><local:PermissionAction Style="{StaticResource PermissionActionStyle}" Content="{Binding ActionName}" IsChecked="{Binding IsGranted, Mode=TwoWay}" AutomationProperties.Name="{Binding Definition.Name}" ToolTipService.ToolTip="{Binding Definition.Name}"/></DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{x:Bind ViewModel.AccessNote, Mode=OneWay}" Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap" Margin="0,-8,0,4"/>
                                    <HyperlinkButton x:Name="ConfigureEmptyButton" Content="Configurar sin permisos" HorizontalAlignment="Left" Padding="0,4" Click="OnConfigureEmpty" Visibility="Collapsed" Foreground="{ThemeResource LimsAccentBrush}" AutomationProperties.Name="Configurar permisos individuales vacíos"/>
                                </StackPanel>
                            </ScrollViewer>
                            <Grid x:Name="HistoryView" Visibility="Collapsed" RowSpacing="12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.HistorySummary, Mode=OneWay}" Style="{StaticResource LimsCaptionStyle}"/>
                                <ListView x:Name="HistoryList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.History}" SelectionMode="None" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Historial de cambios de permisos">
                                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate><DataTemplate>
                                        <Grid Padding="0,12" RowSpacing="6" BorderBrush="{ThemeResource LimsBorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Permission}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><design:StatusBadge Grid.Column="1" Text="{Binding Action}" Tone="{Binding Tone}"/></Grid>
                                            <TextBlock Grid.Row="1" Text="{Binding Change}" Style="{StaticResource LimsCaptionStyle}"/>
                                            <Grid Grid.Row="2" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Actor}" Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding At}" Style="{StaticResource LimsCaptionStyle}"/></Grid>
                                        </Grid>
                                    </DataTemplate></ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="EmptyHistory" Grid.Row="1" Text="Sin cambios registrados para este usuario." Style="{StaticResource LimsCaptionStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
                            </Grid>
                            <StackPanel x:Name="UserLoading" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"><ProgressRing IsActive="{x:Bind ViewModel.IsLoadingUser, Mode=OneWay}" Width="24" Height="24"/><TextBlock Text="Consultando permisos…" Style="{StaticResource LimsCaptionStyle}"/></StackPanel>
                            <ProgressRing x:Name="HistoryLoading" IsActive="{x:Bind ViewModel.IsLoadingHistory, Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock x:Name="LoadFailure" Text="No se pudieron cargar los permisos. Pulse Recargar para volver a consultar." Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340" Visibility="Collapsed"/>
                        </Grid>
                        <Grid x:Name="WorkspaceFooter" Grid.Row="3" Padding="0,12,0,0" BorderBrush="{ThemeResource LimsBorderBrush}" BorderThickness="0,1,0,0">
                            <Grid x:Name="PermissionFooter" ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.ChangeStatus, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource LimsTextSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                    <TextBlock Text="{x:Bind ViewModel.LocalSummary, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource LimsAccentBrush}"/>
                                </StackPanel>
                                <StackPanel x:Name="SaveActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="ReloadButton" Style="{StaticResource LimsSecondaryButtonStyle}" Click="OnReload" Padding="10" AutomationProperties.Name="Recargar" ToolTipService.ToolTip="Recargar permisos"><design:LimsIcon Icon="Replace" Size="16"/></Button>
                                    <Button x:Name="DiscardButton" Content="Descartar" Style="{StaticResource LimsSecondaryButtonStyle}" Click="OnDiscard"/>
                                    <Button x:Name="SaveButton" Style="{StaticResource LimsPrimaryButtonStyle}" IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}" Click="OnSave" AutomationProperties.Name="Guardar cambios">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><design:LimsIcon x:Name="SaveIcon" Icon="Save" Size="16" Foreground="{ThemeResource LimsOnAccentBrush}"/><ProgressRing x:Name="SaveProgress" Width="16" Height="16" IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}" Visibility="Collapsed" Foreground="{ThemeResource LimsOnAccentBrush}"/><TextBlock Text="{x:Bind ViewModel.SaveLabel, Mode=OneWay}"/></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="HistoryFooter" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.HistorySummary, Mode=OneWay}" Style="{StaticResource LimsCaptionStyle}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button x:Name="PreviousHistoryButton" Style="{StaticResource LimsSecondaryButtonStyle}" IsEnabled="{x:Bind ViewModel.HasPreviousHistory, Mode=OneWay}" Click="OnPreviousHistory" AutomationProperties.Name="Página anterior" ToolTipService.ToolTip="Página anterior" Padding="10"><design:LimsIcon Icon="ChevronLeft" Size="16"/></Button><Button x:Name="NextHistoryButton" Style="{StaticResource LimsSecondaryButtonStyle}" IsEnabled="{x:Bind ViewModel.HasMoreHistory, Mode=OneWay}" Click="OnNextHistory" AutomationProperties.Name="Más historial" ToolTipService.ToolTip="Más historial" Padding="10"><design:LimsIcon Icon="ChevronRight" Size="16"/></Button></StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
