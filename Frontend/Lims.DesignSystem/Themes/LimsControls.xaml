<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:motion="using:Lims.DesignSystem.Presentation"
 xmlns:controls="using:Lims.DesignSystem.Controls"
 xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
    <!-- Native TextBox (including AutoSuggestBox's inner editor) reads these keys.
         Keep PlaceholderForeground unset so focused/disabled states can resolve separately. -->
    <SolidColorBrush x:Key="LimsPlaceholderBrush" Color="{ThemeResource LimsTextTertiaryColor}" />
    <SolidColorBrush x:Key="LimsPlaceholderDisabledBrush" Color="{ThemeResource LimsTextTertiaryColor}" Opacity="0.5" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource LimsTextTertiaryColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{ThemeResource LimsTextTertiaryColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{ThemeResource LimsTextTertiaryColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="{ThemeResource LimsTextTertiaryColor}" Opacity="0.5" />
    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundPointerOver" Color="{ThemeResource LimsTextTertiaryColor}" />
    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundPressed" Color="{ThemeResource LimsTextTertiaryColor}" />
    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocused" Color="{ThemeResource LimsTextTertiaryColor}" />
    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocusedPressed" Color="{ThemeResource LimsTextTertiaryColor}" />
    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundDisabled" Color="{ThemeResource LimsTextTertiaryColor}" Opacity="0.5" />
    <SolidColorBrush x:Key="CalendarDatePickerTextForegroundDisabled" Color="{ThemeResource LimsTextTertiaryColor}" Opacity="0.5" />
    <Style x:Key="LimsPlaceholderTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource LimsPlaceholderBrush}" />
    </Style>
    <!-- Preserve WinUI's modal template: it coordinates the popup, smoke layer and hit testing. -->
    <Style x:Key="LimsEditorDialogStyle" TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
        <Setter Property="Foreground" Value="{ThemeResource LimsTextPrimaryBrush}" />
        <Setter Property="Background" Value="{ThemeResource LimsSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LimsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource LimsSurfaceSecondaryColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource LimsSurfaceElevatedColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource LimsAccentSoftColor}" />
    <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource LimsTextPrimaryColor}" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource LimsTextPrimaryColor}" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource LimsTextPrimaryColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{ThemeResource LimsBorderColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource LimsBorderStrongColor}" />
    <SolidColorBrush x:Key="ComboBoxBackground" Color="{ThemeResource LimsInputBackgroundColor}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{ThemeResource LimsSurfaceSecondaryColor}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{ThemeResource LimsSurfaceSecondaryColor}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{ThemeResource LimsInputBackgroundColor}" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{ThemeResource LimsInputBorderColor}" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{ThemeResource LimsInputHoverColor}" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="{ThemeResource LimsFocusColor}" />
    <SolidColorBrush x:Key="ComboBoxForeground" Color="{ThemeResource LimsTextPrimaryColor}" />
    <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="{ThemeResource LimsTextTertiaryColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{ThemeResource LimsSurfaceColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{ThemeResource LimsBorderColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="{ThemeResource LimsTextPrimaryColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{ThemeResource LimsTextSecondaryColor}" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{ThemeResource LimsSurfaceSecondaryColor}" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{ThemeResource LimsAccentSoftColor}" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{ThemeResource LimsSurfaceElevatedColor}" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedUnfocused" Color="{ThemeResource LimsAccentSoftColor}" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="{ThemeResource LimsSurfaceSecondaryColor}" />
    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="{ThemeResource LimsAccentColor}" />
    <SolidColorBrush x:Key="CalendarDatePickerBackground" Color="{ThemeResource LimsInputBackgroundColor}" />
    <SolidColorBrush x:Key="CalendarDatePickerBackgroundPointerOver" Color="{ThemeResource LimsSurfaceSecondaryColor}" />
    <SolidColorBrush x:Key="CalendarDatePickerBorderBrush" Color="{ThemeResource LimsInputBorderColor}" />
    <SolidColorBrush x:Key="CalendarDatePickerBorderBrushPointerOver" Color="{ThemeResource LimsInputHoverColor}" />
    <SolidColorBrush x:Key="CalendarDatePickerBorderBrushFocused" Color="{ThemeResource LimsFocusColor}" />
    <SolidColorBrush x:Key="CalendarDatePickerTextForeground" Color="{ThemeResource LimsTextPrimaryColor}" />
    <SolidColorBrush x:Key="CalendarViewBackground" Color="{ThemeResource LimsSurfaceColor}" />
    <SolidColorBrush x:Key="CalendarViewBorderBrush" Color="{ThemeResource LimsBorderColor}" />
    <SolidColorBrush x:Key="CalendarViewForeground" Color="{ThemeResource LimsTextPrimaryColor}" />
    <SolidColorBrush x:Key="CalendarViewCalendarItemForeground" Color="{ThemeResource LimsTextPrimaryColor}" />
    <SolidColorBrush x:Key="CalendarViewHeaderNavigationButtonForeground" Color="{ThemeResource LimsTextPrimaryColor}" />
    <SolidColorBrush x:Key="CalendarViewSelectedBorderBrush" Color="{ThemeResource LimsAccentColor}" />
    <SolidColorBrush x:Key="CalendarViewSelectedForeground" Color="{ThemeResource LimsAccentHoverColor}" />
    <SolidColorBrush x:Key="CalendarViewCalendarItemHoverBackground" Color="{ThemeResource LimsSurfaceSecondaryColor}" />
    <SolidColorBrush x:Key="CalendarViewTodayBackground" Color="{ThemeResource LimsAccentColor}" />
    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{ThemeResource LimsSurfaceSecondaryColor}" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource LimsAccentSoftColor}" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource LimsSurfaceElevatedColor}" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource LimsSurfaceSecondaryColor}" />
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="{ThemeResource LimsAccentColor}" />
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource LimsSurfaceColor}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource LimsAccentSoftColor}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{ThemeResource LimsSurfaceSecondaryColor}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{ThemeResource LimsSurfaceSecondaryColor}" />
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="{ThemeResource LimsSurfaceElevatedColor}" />
    <SolidColorBrush x:Key="ToolTipForegroundBrush" Color="{ThemeResource LimsTextPrimaryColor}" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{ThemeResource LimsBorderColor}" />
    <SolidColorBrush x:Key="ContentDialogBackground" Color="{ThemeResource LimsSurfaceColor}" />
    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{ThemeResource LimsBorderColor}" />
    <Thickness x:Key="ComboBoxPopupBorderThemeThickness">1</Thickness>
    <Thickness x:Key="ComboBoxDropdownBorderThickness">1</Thickness>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <x:Double x:Key="CalendarViewHeaderNavigationButtonFontSize">13</x:Double>
    <Thickness x:Key="ComboBoxItemThemePadding">12,7</Thickness>
    <x:Double x:Key="NavigationViewItemOnLeftMinHeight">40</x:Double>
    <Thickness x:Key="NavigationViewItemButtonMargin">4,2</Thickness>
    <Thickness x:Key="NavigationViewHeaderMargin">24,12,0,0</Thickness>
    <Style x:Key="LimsPopupSurfaceStyle" TargetType="controls:LimsPopupSurface">
        <Setter Property="Background" Value="{ThemeResource LimsSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LimsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource LimsControlCornerRadius}" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="MaxHeight" Value="340" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="controls:LimsPopupSurface">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                <Border.Shadow><ThemeShadow /></Border.Shadow>
                <Border.Translation>0,0,8</Border.Translation>
                <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" IsTabStop="False">
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" />
                </ScrollViewer>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LimsPopupListStyle" TargetType="ListView">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="4" /><Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource LimsFocusBrush}" />
            <Setter Property="FocusVisualPrimaryThickness" Value="1" /><Setter Property="FocusVisualSecondaryThickness" Value="0" />
        </Style></Setter.Value></Setter>
    </Style>
    <Style x:Key="LimsPopupCalendarStyle" TargetType="CalendarView" BasedOn="{StaticResource DefaultCalendarViewStyle}">
        <Setter Property="Height" Value="260" />
        <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="260" />
        <Setter Property="DayItemFontSize" Value="13" /><Setter Property="MonthYearItemFontSize" Value="13" />
        <Setter Property="CalendarViewDayItemStyle"><Setter.Value><Style TargetType="CalendarViewDayItem">
            <Setter Property="MinWidth" Value="34" /><Setter Property="MinHeight" Value="30" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource LimsFocusBrush}" />
            <Setter Property="FocusVisualPrimaryThickness" Value="1" /><Setter Property="FocusVisualSecondaryThickness" Value="0" />
        </Style></Setter.Value></Setter>
        <Setter Property="CalendarItemBackground" Value="Transparent" /><Setter Property="OutOfScopeBackground" Value="Transparent" />
        <Setter Property="CalendarItemHoverBackground" Value="{ThemeResource LimsSurfaceSecondaryBrush}" />
        <Setter Property="CalendarItemPressedBackground" Value="{ThemeResource LimsAccentSoftBrush}" />
        <Setter Property="SelectedBorderBrush" Value="{ThemeResource LimsAccentBrush}" />
        <Setter Property="SelectedForeground" Value="{ThemeResource LimsTextPrimaryBrush}" />
        <Setter Property="TodayBackground" Value="{ThemeResource LimsAccentSoftBrush}" />
        <Setter Property="TodayForeground" Value="{ThemeResource LimsAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource LimsTextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CalendarView">
            <!-- Public CalendarView template parts retain WinUI date generation, navigation and automation. -->
            <Grid x:Name="CalendarRoot" Background="{TemplateBinding Background}">
                <Grid.Resources>
                    <Style x:Key="LimsCalendarScrollStyle" TargetType="ScrollViewer">
                        <Setter Property="HorizontalScrollMode" Value="Disabled" /><Setter Property="VerticalScrollMode" Value="Enabled" />
                        <Setter Property="VerticalSnapPointsType" Value="Optional" /><Setter Property="ZoomMode" Value="Disabled" />
                        <Setter Property="TabNavigation" Value="Once" /><Setter Property="BringIntoViewOnFocusChange" Value="False" />
                        <Setter Property="Template" Value="{StaticResource ScrollViewerScrollBarlessTemplate}" />
                    </Style>
                    <Style x:Key="LimsWeekDayStyle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Foreground" Value="{ThemeResource LimsTextSecondaryBrush}" />
                    </Style>
                    <Style x:Key="LimsCalendarNavigationStyle" TargetType="Button">
                        <Setter Property="MinWidth" Value="28" /><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="4" />
                        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="4" /><Setter Property="Foreground" Value="{ThemeResource LimsTextPrimaryBrush}" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource LimsFocusBrush}" />
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="CalendarRoot.Opacity" Value="0.5" /></VisualState.Setters></VisualState></VisualStateGroup>
                    <VisualStateGroup x:Name="HeaderButtonStates"><VisualState x:Name="ViewChanged" /><VisualState x:Name="ViewChanging" /></VisualStateGroup>
                    <VisualStateGroup x:Name="DisplayModeStates">
                        <VisualState x:Name="Month" />
                        <VisualState x:Name="Year"><VisualState.Setters>
                            <Setter Target="MonthView.Visibility" Value="Collapsed" /><Setter Target="YearViewScrollViewer.Visibility" Value="Visible" />
                        </VisualState.Setters></VisualState>
                        <VisualState x:Name="Decade"><VisualState.Setters>
                            <Setter Target="MonthView.Visibility" Value="Collapsed" /><Setter Target="DecadeViewScrollViewer.Visibility" Value="Visible" />
                        </VisualState.Setters></VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                    <Button x:Name="PreviousButton" Content="‹" FontSize="22" Style="{StaticResource LimsCalendarNavigationStyle}" AutomationProperties.Name="Mes anterior"
                        IsEnabled="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.HasMoreContentBefore}" />
                    <Button x:Name="HeaderButton" Grid.Column="1" Style="{StaticResource LimsCalendarNavigationStyle}" HorizontalContentAlignment="Center"
                        Content="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.HeaderText}"
                        IsEnabled="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.HasMoreViews}" />
                    <Button x:Name="NextButton" Grid.Column="2" Content="›" FontSize="22" Style="{StaticResource LimsCalendarNavigationStyle}" AutomationProperties.Name="Mes siguiente"
                        IsEnabled="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.HasMoreContentAfter}" />
                </Grid>
                <Grid x:Name="Views" Grid.Row="1">
                    <Grid x:Name="MonthView">
                        <Grid.RowDefinitions><RowDefinition Height="24" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid x:Name="WeekDayNames">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="WeekDay1" Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.WeekDay1}" Style="{StaticResource LimsWeekDayStyle}" />
                            <TextBlock x:Name="WeekDay2" Grid.Column="1" Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.WeekDay2}" Style="{StaticResource LimsWeekDayStyle}" />
                            <TextBlock x:Name="WeekDay3" Grid.Column="2" Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.WeekDay3}" Style="{StaticResource LimsWeekDayStyle}" />
                            <TextBlock x:Name="WeekDay4" Grid.Column="3" Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.WeekDay4}" Style="{StaticResource LimsWeekDayStyle}" />
                            <TextBlock x:Name="WeekDay5" Grid.Column="4" Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.WeekDay5}" Style="{StaticResource LimsWeekDayStyle}" />
                            <TextBlock x:Name="WeekDay6" Grid.Column="5" Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.WeekDay6}" Style="{StaticResource LimsWeekDayStyle}" />
                            <TextBlock x:Name="WeekDay7" Grid.Column="6" Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.WeekDay7}" Style="{StaticResource LimsWeekDayStyle}" />
                        </Grid>
                        <ScrollViewer x:Name="MonthViewScrollViewer" Grid.Row="1" IsFocusEngagementEnabled="True" Style="{StaticResource LimsCalendarScrollStyle}"><CalendarPanel x:Name="MonthViewPanel" /></ScrollViewer>
                    </Grid>
                    <ScrollViewer x:Name="YearViewScrollViewer" Visibility="Collapsed" IsFocusEngagementEnabled="True" Style="{StaticResource LimsCalendarScrollStyle}"><CalendarPanel x:Name="YearViewPanel" /></ScrollViewer>
                    <ScrollViewer x:Name="DecadeViewScrollViewer" Visibility="Collapsed" IsFocusEngagementEnabled="True" Style="{StaticResource LimsCalendarScrollStyle}"><CalendarPanel x:Name="DecadeViewPanel" /></ScrollViewer>
                </Grid>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LimsPopupFieldStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="13" /><Setter Property="CornerRadius" Value="{StaticResource LimsControlCornerRadius}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{ThemeResource LimsInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LimsInputBorderBrush}" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource LimsTextPrimaryBrush}" /><Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource LimsFocusBrush}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Grid x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Control.IsTemplateFocusTarget="True">
                <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver"><VisualState.Setters>
                        <Setter Target="Field.BorderBrush" Value="{ThemeResource LimsInputHoverBrush}" />
                        <Setter Target="Field.Background" Value="{ThemeResource LimsSurfaceSecondaryBrush}" />
                    </VisualState.Setters></VisualState>
                    <VisualState x:Name="Pressed"><VisualState.Setters>
                        <Setter Target="Field.Background" Value="{ThemeResource LimsAccentSoftBrush}" />
                        <Setter Target="Field.BorderBrush" Value="{ThemeResource LimsFocusBrush}" />
                    </VisualState.Setters></VisualState>
                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Field.Opacity" Value="0.5" /></VisualState.Setters></VisualState>
                </VisualStateGroup><VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Unfocused" /><VisualState x:Name="PointerFocused" />
                    <VisualState x:Name="Focused"><VisualState.Setters><Setter Target="FocusBorder.Opacity" Value="1" /></VisualState.Setters></VisualState>
                </VisualStateGroup></VisualStateManager.VisualStateGroups>
                <Border x:Name="FocusBorder" BorderBrush="{ThemeResource LimsFocusBrush}" BorderThickness="2" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
                <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LimsFormLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource LimsTextSecondaryBrush}" />
    </Style>
    <Style x:Key="LimsInlineErrorStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" /><Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource LimsDangerBrush}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
    </Style>
    <Style x:Key="LimsDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" /><Setter Property="Background" Value="{ThemeResource LimsBorderBrush}" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style x:Key="LimsDetailHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource LimsFormLabelStyle}">
        <Setter Property="CharacterSpacing" Value="70" /><Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="LimsTableHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource LimsFormLabelStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="LimsCompactTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="13" /><Setter Property="CornerRadius" Value="{StaticResource LimsControlCornerRadius}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{ThemeResource LimsInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LimsInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource LimsTextPrimaryBrush}" />
    </Style>
    <Style x:Key="LimsCompactSearchStyle" TargetType="AutoSuggestBox" BasedOn="{StaticResource DefaultAutoSuggestBoxStyle}">
        <Setter Property="MinHeight" Value="36" /><Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="{StaticResource LimsControlCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource LimsInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LimsInputBorderBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource LimsTextPrimaryBrush}" />
    </Style>
    <Style x:Key="LimsCompactComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="10,6,30,6" />
        <Setter Property="FontSize" Value="13" /><Setter Property="CornerRadius" Value="{StaticResource LimsControlCornerRadius}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="MaxDropDownHeight" Value="300" />
        <Setter Property="IsTextSearchEnabled" Value="True" />
        <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
            <Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="4" /><Setter Property="FontSize" Value="13" />
        </Style></Setter.Value></Setter>
    </Style>
    <Style x:Key="LimsCalendarViewStyle" TargetType="CalendarView" BasedOn="{StaticResource DefaultCalendarViewStyle}">
        <Setter Property="DayItemFontSize" Value="14" />
        <Setter Property="MonthYearItemFontSize" Value="14" />
        <Setter Property="CalendarItemBackground" Value="Transparent" />
        <Setter Property="OutOfScopeBackground" Value="Transparent" />
        <Setter Property="CalendarItemHoverBackground" Value="{ThemeResource LimsSurfaceSecondaryBrush}" />
        <Setter Property="CalendarItemPressedBackground" Value="{ThemeResource LimsAccentSoftBrush}" />
        <Setter Property="SelectedBorderBrush" Value="{ThemeResource LimsAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource LimsTextPrimaryBrush}" />
        <Setter Property="Background" Value="{ThemeResource LimsSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LimsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="LimsCompactCalendarStyle" TargetType="CalendarDatePicker" BasedOn="{StaticResource DefaultCalendarDatePicker}">
        <Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="13" /><Setter Property="CornerRadius" Value="{StaticResource LimsControlCornerRadius}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="Language" Value="es-GT" />
        <Setter Property="DateFormat" Value="{}{day.integer(2)}/{month.integer(2)}/{year.full}" />
        <Setter Property="CalendarViewStyle" Value="{StaticResource LimsCalendarViewStyle}" />
    </Style>
    <Style x:Key="LimsSecondaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="14,7" />
        <Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="{StaticResource LimsControlCornerRadius}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="motion:Motion.IsEnabled" Value="True" />
        <Setter Property="Background" Value="{ThemeResource LimsSurfaceSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LimsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource LimsTextPrimaryBrush}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Control.IsTemplateFocusTarget="True">
                <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.09" /></VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="0.08" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hover.Opacity" Value="0.13" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.42" /></VisualState.Setters></VisualState>
                </VisualStateGroup></VisualStateManager.VisualStateGroups>
                <Border x:Name="Hover" Background="{TemplateBinding Foreground}" Opacity="0" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LimsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource LimsSecondaryButtonStyle}">
        <Setter Property="motion:Motion.PressedScale" Value="0.965" />
        <Setter Property="Background" Value="{ThemeResource LimsAccentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LimsAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource LimsOnAccentBrush}" />
    </Style>
    <Style x:Key="LimsDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource LimsSecondaryButtonStyle}">
        <Setter Property="motion:Motion.PressedScale" Value="0.965" />
        <Setter Property="Background" Value="{ThemeResource LimsDangerSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LimsDangerBorderBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource LimsDangerBrush}" />
    </Style>
    <Style x:Key="LimsStandardsSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource LimsSecondaryButtonStyle}">
        <Setter Property="motion:Motion.PressedScale" Value="0.965" />
