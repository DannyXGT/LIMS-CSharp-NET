<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lims.Desktop.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource LimsBackgroundBrush}">
    <NavigationView
        x:Name="MainNavigation"
        AlwaysShowHeader="True"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        OpenPaneLength="252"
        PaneDisplayMode="Left"
        SelectionChanged="OnSelectionChanged">
        <NavigationView.PaneHeader>
            <StackPanel Margin="4,18,4,14" Spacing="3">
                <TextBlock Style="{StaticResource LimsProductTitleStyle}" Text="LIMS" />
                <TextBlock Style="{StaticResource LimsCaptionStyle}" Text="Gestión de laboratorio" />
            </StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="HomeItem" Content="Inicio" Icon="Home" Tag="home" />
            <NavigationViewItemSeparator />
            <NavigationViewItemHeader Content="MATERIALES DE REFERENCIA" />
            <NavigationViewItem x:Name="StandardsItem" Content="Estándares" Icon="Library" IsEnabled="{x:Bind ViewModel.CanViewReferenceMaterials, Mode=OneWay}" Tag="standards" />
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <Border Margin="8,8,8,16" Padding="12" Background="{ThemeResource LimsSurfaceSecondaryBrush}" CornerRadius="{StaticResource LimsCornerRadiusMedium}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" Background="{ThemeResource LimsAccentBrush}" CornerRadius="18">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" Text="{x:Bind ViewModel.Initials, Mode=OneWay}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource LimsCaptionStyle}" Text="{x:Bind ViewModel.Role, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Width="36" Height="36" AutomationProperties.Name="Cerrar sesión" Command="{x:Bind ViewModel.LogoutCommand}" ToolTipService.ToolTip="Cerrar sesión">
                        <FontIcon FontSize="15" Glyph="&#xE8AC;" />
                    </Button>
                </Grid>
            </Border>
        </NavigationView.PaneFooter>
        <NavigationView.Header>
            <Grid Margin="0,0,24,0" ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="SectionTitle" FontSize="22" FontWeight="SemiBold" Text="Inicio" />
                    <TextBlock x:Name="SectionSubtitle" Style="{StaticResource LimsCaptionStyle}" Text="Panel principal" />
                </StackPanel>
            </Grid>
        </NavigationView.Header>
        <Grid Padding="24,8,24,24">
            <Grid x:Name="HomePanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Padding="28" Background="{ThemeResource LimsSurfaceBrush}" BorderBrush="{ThemeResource LimsBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource LimsSurfaceCornerRadius}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource LimsPageTitleStyle}" Text="Bienvenido al LIMS" />
                            <TextBlock MaxWidth="720" HorizontalAlignment="Left" Style="{StaticResource LimsBodyStyle}" Text="La autenticación está activa. Materiales de Referencia es el primer módulo operativo integrado a esta nueva base .NET." />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="16,8" Background="{ThemeResource LimsAccentSoftBrush}" CornerRadius="8"><TextBlock Foreground="{ThemeResource LimsAccentHoverBrush}" Text="Sesión activa" /></Border>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Margin="0,20,0,0" Padding="22" Background="{ThemeResource LimsSurfaceBrush}" CornerRadius="12"><StackPanel Spacing="8"><FontIcon HorizontalAlignment="Left" Foreground="{ThemeResource LimsAccentBrush}" Glyph="&#xE8F1;" /><TextBlock Style="{StaticResource LimsSectionTitleStyle}" Text="Materiales de Referencia" /><TextBlock Style="{StaticResource LimsBodyStyle}" Text="Gestione estándares, su presentación, disponibilidad, estado y trazabilidad de cambios." /></StackPanel></Border>
            </Grid>
            <ContentControl x:Name="StandardsHost" Visibility="Collapsed" />
        </Grid>
    </NavigationView>
</Page>
