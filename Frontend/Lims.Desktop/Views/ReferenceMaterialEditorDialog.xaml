<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Lims.Desktop.Views.ReferenceMaterialEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Language="es-GT"
    Opened="OnOpened"
    Closing="OnClosing"
    Title="Nuevo estándar">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1040</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">920</x:Double>
        <Style x:Key="EditorSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource LimsDisplayFontFamily}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource LimsTextPrimaryBrush}" />
        </Style>
        <Style x:Key="EditorErrorStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource LimsErrorTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </ContentDialog.Resources>

    <Grid x:Name="EditorRoot" MinWidth="360">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="EditorScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="2,2,10,18" Spacing="22">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" Background="{ThemeResource LimsAccentSoftBrush}" CornerRadius="6">
                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource LimsAccentBrush}" Glyph="&#xE946;" />
                        </Border>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource EditorSectionTitleStyle}" Text="Identificación" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource LimsBorderBrush}" />

                    <StackPanel Spacing="3">
                        <TextBox x:Name="NameBox" Header="Nombre del estándar *" MaxLength="200" />
                        <TextBlock x:Name="NameError" Style="{StaticResource EditorErrorStyle}" />
                    </StackPanel>

                    <Grid ColumnSpacing="18" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="3">
                            <TextBox x:Name="CasBox" Header="CAS" MaxLength="80" PlaceholderText="Ej. 64-17-5" />
                            <TextBlock x:Name="CasError" Style="{StaticResource EditorErrorStyle}" />
                        </StackPanel>
                        <TextBox x:Name="CatalogBox" Grid.Column="1" Header="Número de catálogo" MaxLength="80" />
                        <StackPanel Grid.Row="1" Spacing="3">
                            <ComboBox x:Name="MethodBox" HorizontalAlignment="Stretch" DisplayMemberPath="Name" Header="Método *" IsTextSearchEnabled="True" PlaceholderText="Seleccione un método" />
                            <TextBlock x:Name="MethodError" Style="{StaticResource EditorErrorStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                            <TextBox x:Name="BrandBox" Header="Marca *" MaxLength="120" />
                            <TextBlock x:Name="BrandError" Style="{StaticResource EditorErrorStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Spacing="3">
                            <TextBox x:Name="LotBox" Header="Lote *" MaxLength="120" />
                            <TextBlock x:Name="LotError" Style="{StaticResource EditorErrorStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" Background="{ThemeResource LimsAccentSoftBrush}" CornerRadius="6">
                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource LimsAccentBrush}" Glyph="&#xE73E;" />
                        </Border>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource EditorSectionTitleStyle}" Text="Calidad y vigencia" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource LimsBorderBrush}" />

                    <Grid ColumnSpacing="18" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="3">
                            <NumberBox x:Name="PurityBox" Header="Pureza (%) *" Maximum="100" Minimum="0.0001" SmallChange="0.01" SpinButtonPlacementMode="Compact" Value="100" />
                            <TextBlock x:Name="PurityError" Style="{StaticResource EditorErrorStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="3">
                            <DatePicker x:Name="ReceivedDatePicker" HorizontalAlignment="Stretch" CalendarIdentifier="GregorianCalendar" Header="Fecha de ingreso *" Language="es-GT" />
                            <TextBlock x:Name="ReceivedDateError" Style="{StaticResource EditorErrorStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                            <DatePicker x:Name="ExpirationDatePicker" HorizontalAlignment="Stretch" CalendarIdentifier="GregorianCalendar" Header="Fecha de expiración *" Language="es-GT" />
                            <TextBlock x:Name="ExpirationError" Style="{StaticResource EditorErrorStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" Background="{ThemeResource LimsAccentSoftBrush}" CornerRadius="6">
                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource LimsAccentBrush}" Glyph="&#xE7B8;" />
                        </Border>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource EditorSectionTitleStyle}" Text="Presentación" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource LimsBorderBrush}" />

                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="0.72*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <NumberBox x:Name="PresentationBox" Header="Presentación por unidad *" Minimum="0.000001" SmallChange="0.1" SpinButtonPlacementMode="Compact" />
                            <TextBlock x:Name="PresentationError" Style="{StaticResource EditorErrorStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <ComboBox x:Name="UnitCombo" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName" Header="Unidad *" PlaceholderText="Seleccione una unidad" />
                            <TextBlock x:Name="UnitError" Style="{StaticResource EditorErrorStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="3">
                            <NumberBox x:Name="PackageCountBox" Header="Número de unidades *" Minimum="1" SmallChange="1" SpinButtonPlacementMode="Compact" Value="1" />
                            <TextBlock x:Name="PackageCountError" Style="{StaticResource EditorErrorStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" Background="{ThemeResource LimsAccentSoftBrush}" CornerRadius="6">
                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource LimsAccentBrush}" Glyph="&#xE80F;" />
                        </Border>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource EditorSectionTitleStyle}" Text="Almacenamiento" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource LimsBorderBrush}" />

                    <StackPanel Spacing="12">
                        <StackPanel Spacing="3">
                            <ComboBox x:Name="StorageLocationBox" HorizontalAlignment="Stretch" DisplayMemberPath="Name" Header="Ubicación física *" PlaceholderText="Seleccione una ubicación" />
                            <TextBlock x:Name="StorageLocationError" Style="{StaticResource EditorErrorStyle}" />
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBox x:Name="StorageTemperatureBox" Header="Temperatura de almacenamiento *" MaxLength="160" PlaceholderText="Ej. 4 °C, -20 °C, T ambiente o 2–8 °C" />
                            <TextBlock x:Name="StorageTemperatureError" Style="{StaticResource EditorErrorStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="0,14,0,0" BorderBrush="{ThemeResource LimsBorderBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SaveError" MaxWidth="480" VerticalAlignment="Center" Foreground="{ThemeResource LimsErrorTextBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                <Button x:Name="CancelButton" Grid.Column="1" MinWidth="92" Click="OnCancelClick" Content="Cancelar" />
                <Button x:Name="SaveButton" Grid.Column="2" MinWidth="164" Click="OnSaveClick" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="SaveProgressRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                        <TextBlock x:Name="SaveButtonText" Text="Guardar estándar" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
