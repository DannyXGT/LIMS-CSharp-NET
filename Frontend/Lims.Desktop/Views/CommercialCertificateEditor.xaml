<UserControl x:Class="Lims.Desktop.Views.CommercialCertificateEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:design="using:Lims.DesignSystem.Controls">
 <StackPanel Spacing="10">
  <TextBlock x:Name="ValidityHint" Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap"/>
  <Grid><TextBlock Text="COMPOSICIÓN CERTIFICADA" Style="{StaticResource LimsSectionTitleStyle}" VerticalAlignment="Center"/><Button x:Name="AddComponentButton" Content="Agregar componente" HorizontalAlignment="Right" Click="OnAddComponent" Style="{StaticResource LimsSecondaryButtonStyle}"/></Grid>
  <TextBlock Text="Una fila por analito certificado; todos comparten el saldo del frasco. Los cálculos usan la concentración certificada." Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap"/>
  <ScrollViewer MaxHeight="270" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel MinWidth="700" Spacing="4">
   <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions><TextBlock Text="Compuesto *" Style="{StaticResource LimsCaptionStyle}"/><TextBlock Grid.Column="1" Text="CAS" Style="{StaticResource LimsCaptionStyle}"/><TextBlock Grid.Column="2" Text="Concentración *" Style="{StaticResource LimsCaptionStyle}"/><TextBlock Grid.Column="3" Text="Unidad *" Style="{StaticResource LimsCaptionStyle}"/></Grid>
   <StackPanel x:Name="ComponentRows" Spacing="4"/>
  </StackPanel></ScrollViewer>
  <StackPanel Spacing="4"><Button Content="Pegar componentes desde Excel" Click="OnPasteComponents" Style="{StaticResource LimsSecondaryButtonStyle}" HorizontalAlignment="Left"/><TextBlock x:Name="PasteError" Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap"/></StackPanel>
  <Expander Header="Datos del fabricante (opcional)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="10">
  <Grid ColumnSpacing="12" RowSpacing="10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBox x:Name="ReferenceBox" Header="Referencia del certificado (opcional)" Style="{StaticResource LimsCompactTextBoxStyle}"/>
   <TextBox x:Name="MatrixBox" Grid.Column="1" Header="Matriz química (si consta)" Style="{StaticResource LimsCompactTextBoxStyle}"/>
   <TextBox x:Name="TraceabilityBox" Grid.Row="1" Header="Trazabilidad" Style="{StaticResource LimsCompactTextBoxStyle}"/>
   <TextBox x:Name="CoverageBox" Grid.Row="1" Grid.Column="1" Header="Factor de cobertura k (si consta)" Style="{StaticResource LimsCompactTextBoxStyle}"/>
   <TextBox x:Name="NominalBox" Grid.Row="2" Header="Concentración nominal (opcional)" Style="{StaticResource LimsCompactTextBoxStyle}"/>
   <TextBox x:Name="NominalUnitBox" Grid.Row="2" Grid.Column="1" Header="Unidad nominal" Style="{StaticResource LimsCompactTextBoxStyle}"/>
   <StackPanel Grid.Row="3" Spacing="4"><TextBlock Text="Fecha de apertura" Style="{StaticResource LimsFormLabelStyle}"/><design:LimsDatePicker x:Name="OpeningPicker" AutomationProperties.Name="Fecha de apertura del frasco"/></StackPanel>
   <StackPanel Grid.Row="3" Grid.Column="1" Spacing="6"><TextBox x:Name="MonthsBox" Header="Uso máximo tras apertura (si consta)" Style="{StaticResource LimsCompactTextBoxStyle}"/><design:LimsSelect x:Name="PeriodUnitSelect" AutomationProperties.Name="Unidad del periodo tras apertura"/></StackPanel>
  </Grid>
  </StackPanel></Expander>
  <Expander Header="Otras expresiones certificadas" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
   <StackPanel Spacing="8"><TextBlock Text="Se conservan por separado. No se convierten fracciones de masa a concentraciones volumétricas sin densidad documentada." Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap"/><StackPanel x:Name="ExpressionRows" Spacing="6"/><Button Content="+ Expresión certificada" Click="OnAddExpression" Style="{StaticResource LimsSecondaryButtonStyle}"/></StackPanel>
  </Expander>
 </StackPanel>
</UserControl>
