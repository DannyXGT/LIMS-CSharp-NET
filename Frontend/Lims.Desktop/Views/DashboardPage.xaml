<Page x:Class="Lims.Desktop.Views.DashboardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <Grid RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="DashboardHeader" Padding="0,8">
            <TextBlock x:Name="DashboardTitle" Text="Resumen dashboard" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource LimsTextPrimaryBrush}"/>
        </Border>
        <ScrollViewer x:Name="DashboardScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentStack" Spacing="10" Padding="0,0,0,12">
                <InfoBar x:Name="ErrorBar" IsClosable="False" Severity="Error" Title="Datos no disponibles">
                    <InfoBar.ActionButton><Button x:Name="RetryButton" Content="Reintentar" Click="OnRetry"/></InfoBar.ActionButton>
                </InfoBar>
                <StackPanel x:Name="EmptyPanel" Visibility="Collapsed"/>
                <Grid x:Name="MetricsGrid" RowSpacing="12" ColumnSpacing="12"/>
                <Grid x:Name="OverviewGrid" RowSpacing="12" ColumnSpacing="12"/>
                <Grid x:Name="AnalyticsGrid" RowSpacing="12" ColumnSpacing="12"/>
                <Grid x:Name="OperationsGrid" RowSpacing="12" ColumnSpacing="12"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
