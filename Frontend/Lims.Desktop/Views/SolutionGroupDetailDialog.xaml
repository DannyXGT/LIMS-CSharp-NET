<ContentDialog x:Class="Lims.Desktop.Views.SolutionGroupDetailDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:design="using:Lims.DesignSystem.Controls" xmlns:contracts="using:Lims.Contracts.ReferencePreparations" xmlns:local="using:Lims.Desktop.Controls"
 Style="{StaticResource LimsEditorDialogStyle}" CloseButtonText="Cerrar" Opened="OnOpened" Closed="OnClosed" Language="es-GT">
 <ContentDialog.Resources><x:Double x:Key="ContentDialogMaxWidth">1320</x:Double><x:Double x:Key="ContentDialogMaxHeight">1200</x:Double></ContentDialog.Resources>
 <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel x:Name="DetailRoot" Spacing="12" Padding="0,0,12,8">
   <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Spacing="3"><TextBlock Text="{x:Bind Detail.Preparation.Name}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Detail.Preparation.Code}" FontSize="12" Foreground="{ThemeResource LimsTextSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><TextBlock x:Name="KindAndMethod" FontSize="13" TextWrapping="Wrap"/></StackPanel>
    <design:StatusBadge Grid.Column="1" Text="{x:Bind Detail.Preparation.StatusLabel}" Tone="{x:Bind Detail.Preparation.StatusTone}" VerticalAlignment="Top"/>
   </Grid>
   <Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Spacing="3"><TextBlock Text="Preparación" Style="{StaticResource LimsCaptionStyle}"/><TextBlock Text="{x:Bind Detail.Preparation.DateDisplay}" FontSize="13"/></StackPanel>
    <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Expiración" Style="{StaticResource LimsCaptionStyle}"/><TextBlock Text="{x:Bind Detail.Preparation.ExpirationDisplay}" FontSize="13"/></StackPanel>
    <StackPanel Grid.Column="2" Spacing="3"><TextBlock Text="Responsable" Style="{StaticResource LimsCaptionStyle}"/><TextBlock Text="{x:Bind Detail.Preparation.PreparedBy}" FontSize="13" TextWrapping="Wrap"/></StackPanel>
   </Grid>
   <Grid x:Name="SummaryMetrics" ColumnSpacing="8" RowSpacing="8"/>
   <Grid x:Name="DetailWorkspace" ColumnSpacing="16" RowSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="PreviewColumn" Width="390"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Spacing="10">
     <TextBlock Text="COMPOSICIÓN · SELECCIONE UNA SOLUCIÓN" Style="{StaticResource LimsSectionTitleStyle}" TextWrapping="Wrap"/>
     <Grid ColumnSpacing="8" Padding="10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Solución / tipo" Style="{StaticResource LimsCaptionStyle}"/><TextBlock Grid.Column="1" Text="Intermedia de origen" Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="Tomado" Style="{StaticResource LimsCaptionStyle}"/><TextBlock Grid.Column="3" Text="Aforo" Style="{StaticResource LimsCaptionStyle}"/></Grid>
     <ListView x:Name="SolutionsList" ItemsSource="{x:Bind Detail.Calculation.Parts}" SelectionMode="Single" SelectionChanged="OnSolutionChanged" MaxHeight="220" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Soluciones de la preparación">
      <ListView.ItemTemplate><DataTemplate x:DataType="contracts:SolutionPart"><Grid ColumnSpacing="8" Padding="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Label}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{x:Bind Source.Code}" FontSize="12" TextWrapping="Wrap" ToolTipService.ToolTip="{x:Bind Source.Name}"/><TextBlock Grid.Column="2" Text="{x:Bind TakenDisplay}" FontSize="12" TextWrapping="Wrap"/><TextBlock Grid.Column="3" Text="{x:Bind FinalDisplay}" FontSize="12" TextWrapping="Wrap"/></Grid></DataTemplate></ListView.ItemTemplate>
     </ListView>
     <TextBlock Text="TRAZABILIDAD · CONSUMOS REGISTRADOS" Style="{StaticResource LimsSectionTitleStyle}" TextWrapping="Wrap"/>
     <StackPanel x:Name="ConsumptionRows" Spacing="8"/>
     <Expander Header="Registro y referencias de movimientos" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel x:Name="AuditRows" Spacing="10"/></Expander>
     <Expander Header="Almacenamiento y observaciones" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="6"><TextBlock Text="Temperatura de almacenamiento" Style="{StaticResource LimsCaptionStyle}"/><TextBlock x:Name="TemperatureText" TextWrapping="Wrap"/><TextBlock Text="Observaciones" Style="{StaticResource LimsCaptionStyle}"/><TextBlock x:Name="NotesText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></StackPanel></Expander>
    </StackPanel>
    <Border x:Name="SelectedResult" Grid.Column="1" Padding="12" CornerRadius="8" Background="{ThemeResource LimsSurfaceSecondaryBrush}" BorderBrush="{ThemeResource LimsBorderBrush}" BorderThickness="1" VerticalAlignment="Top"><local:SolutionResultView x:Name="ResultView"/></Border>
   </Grid>
  </StackPanel>
 </ScrollViewer>
</ContentDialog>
