<ContentDialog xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:design="using:Lims.DesignSystem.Controls" x:Class="Lims.Desktop.Views.StockDetailDialog" Language="es-GT" Style="{StaticResource LimsEditorDialogStyle}" Title="Preparación Stock" CloseButtonText="Cerrar" Opened="OnOpened" Closed="OnClosed">
 <ContentDialog.Resources>
  <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
  <x:Double x:Key="ContentDialogMaxHeight">940</x:Double>
 </ContentDialog.Resources>
 <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel x:Name="DetailSurface" Spacing="16" Padding="2,2,12,12">
   <TextBlock Text="{x:Bind Detail.Preparation.Name}" Style="{StaticResource LimsPageTitleStyle}" TextWrapping="Wrap"/>
   <TextBlock Text="{x:Bind Detail.Preparation.Code}" Style="{StaticResource LimsCaptionStyle}"/>
   <design:StatusBadge Text="{x:Bind Detail.Preparation.StatusLabel}" Tone="{x:Bind Detail.Preparation.StatusTone}" HorizontalAlignment="Left"/>
   <TextBlock Text="{x:Bind PreparedDisplay}" Style="{StaticResource LimsCaptionStyle}"/>
   <Border Padding="18" Background="{ThemeResource LimsAccentSoftBrush}" CornerRadius="10">
    <StackPanel Spacing="14">
     <TextBlock Text="RESUMEN" Style="{StaticResource LimsSectionTitleStyle}"/>
     <Grid ColumnSpacing="18" RowSpacing="14">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Column="0" Grid.Row="0">
       <StackPanel Spacing="4">
        <TextBlock Text="CONCENTRACIÓN REAL" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock Text="{x:Bind Detail.Preparation.ConcentrationDisplay}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Grid.Row="0">
       <StackPanel Spacing="4">
        <TextBlock Text="VOLUMEN FINAL" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock Text="{x:Bind Detail.Preparation.FinalDisplay}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="0" Grid.Row="1">
       <StackPanel Spacing="4">
        <TextBlock Text="PESO TOMADO" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock Text="{x:Bind Detail.Calculation.ConsumedDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Grid.Row="1">
       <StackPanel Spacing="4">
        <TextBlock Text="EXPIRACIÓN" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock Text="{x:Bind Detail.Preparation.ExpirationDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
     </Grid>
    </StackPanel>
   </Border>
   <Border Padding="18" Background="{ThemeResource LimsSurfaceSecondaryBrush}" CornerRadius="10">
    <StackPanel Spacing="14">
     <TextBlock Text="ESTÁNDAR ORIGEN" Style="{StaticResource LimsSectionTitleStyle}"/>
     <StackPanel Spacing="4">
      <TextBlock Text="Nombre" Style="{StaticResource LimsCaptionStyle}"/>
      <TextBlock Text="{x:Bind Detail.Source.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
     </StackPanel>
     <Grid ColumnSpacing="18" RowSpacing="14">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Column="0" Grid.Row="0">
       <StackPanel Spacing="4">
        <TextBlock Text="CAS" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock Text="{x:Bind SourceCas}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Grid.Row="0">
       <StackPanel Spacing="4">
        <TextBlock Text="Catálogo" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock Text="{x:Bind SourceCatalog}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="0" Grid.Row="1">
       <StackPanel Spacing="4">
        <TextBlock Text="Lote" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock Text="{x:Bind Detail.Source.Lot}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Grid.Row="1">
       <StackPanel Spacing="4">
        <TextBlock Text="Marca" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock Text="{x:Bind Detail.Source.Brand}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="0" Grid.Row="2">
       <StackPanel Spacing="4">
        <TextBlock Text="Método" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock Text="{x:Bind Detail.Source.Method}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Grid.Row="2">
       <StackPanel Spacing="4">
        <TextBlock Text="Pureza usada" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock Text="{x:Bind Detail.Calculation.PurityDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
     </Grid>
    </StackPanel>
   </Border>
   <Border Padding="18" Background="{ThemeResource LimsSurfaceSecondaryBrush}" CornerRadius="10">
    <StackPanel Spacing="14">
     <TextBlock Text="CÁLCULO" Style="{StaticResource LimsSectionTitleStyle}"/>
     <Grid ColumnSpacing="18" RowSpacing="14">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Column="0" Grid.Row="0">
       <StackPanel Spacing="4">
        <TextBlock Text="Objetivo" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock Text="{x:Bind Detail.Calculation.TargetDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Grid.Row="0">
       <StackPanel Spacing="4">
        <TextBlock Text="Peso a tomar" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock Text="{x:Bind Detail.Calculation.RequiredDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="0" Grid.Row="1">
       <StackPanel Spacing="4">
        <TextBlock Text="Peso tomado" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock Text="{x:Bind Detail.Calculation.ConsumedDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Grid.Row="1">
       <StackPanel Spacing="4">
        <TextBlock Text="Concentración real" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock Text="{x:Bind Detail.Calculation.ConcentrationDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="0" Grid.Row="2">
       <StackPanel Spacing="4">
        <TextBlock Text="Diferencia" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock Text="{x:Bind Detail.Calculation.DifferenceDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
     </Grid>
     <TextBlock Text="{x:Bind Detail.Calculation.Formula}" Style="{StaticResource LimsCaptionStyle}" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
   <Border Padding="18" Background="{ThemeResource LimsSurfaceSecondaryBrush}" CornerRadius="10">
    <StackPanel Spacing="14">
     <TextBlock Text="CONSUMO DEL ESTÁNDAR" Style="{StaticResource LimsSectionTitleStyle}"/>
     <Grid ColumnSpacing="18" RowSpacing="14">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Column="0" Grid.Row="0">
       <StackPanel Spacing="4">
        <TextBlock Text="Antes" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock Text="{x:Bind Detail.Consumption.BeforeDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Grid.Row="0">
       <StackPanel Spacing="4">
        <TextBlock Text="Consumido" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock Text="{x:Bind ConsumedDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="0" Grid.Row="1">
       <StackPanel Spacing="4">
        <TextBlock Text="Después" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock Text="{x:Bind Detail.Consumption.AfterDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
     </Grid>
    </StackPanel>
   </Border>
   <Border Padding="18" Background="{ThemeResource LimsSurfaceSecondaryBrush}" CornerRadius="10">
    <StackPanel Spacing="14">
     <TextBlock Text="TRAZABILIDAD" Style="{StaticResource LimsSectionTitleStyle}"/>
     <Grid ColumnSpacing="18" RowSpacing="14">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Column="0" Grid.Row="0">
       <StackPanel Spacing="4">
        <TextBlock Text="Preparado por" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock Text="{x:Bind Detail.Preparation.PreparedBy}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Grid.Row="0">
       <StackPanel Spacing="4">
        <TextBlock Text="Fecha preparación" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock Text="{x:Bind Detail.Preparation.DateDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="0" Grid.Row="1">
       <StackPanel Spacing="4">
        <TextBlock Text="Movimiento registrado por" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock Text="{x:Bind Detail.Consumption.Actor}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Grid.Row="1">
       <StackPanel Spacing="4">
        <TextBlock Text="Fecha del movimiento" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock Text="{x:Bind Detail.Consumption.OccurredDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="0" Grid.Row="2">
       <StackPanel Spacing="4">
        <TextBlock Text="Creado" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock Text="{x:Bind Detail.CreatedDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Grid.Row="2">
       <StackPanel Spacing="4">
        <TextBlock Text="Actualizado" Style="{StaticResource LimsCaptionStyle}"/>
        <TextBlock Text="{x:Bind Detail.UpdatedDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
     </Grid>
    </StackPanel>
   </Border>
   <Border Padding="18" Background="{ThemeResource LimsSurfaceSecondaryBrush}" CornerRadius="10">
    <StackPanel Spacing="14">
     <TextBlock Text="ALMACENAMIENTO Y OBSERVACIONES" Style="{StaticResource LimsSectionTitleStyle}"/>
     <StackPanel Spacing="4">
      <TextBlock Text="Temperatura de almacenamiento" Style="{StaticResource LimsCaptionStyle}"/>
      <TextBlock Text="{x:Bind StorageDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
     </StackPanel>
     <StackPanel Spacing="4">
      <TextBlock Text="Observaciones" Style="{StaticResource LimsCaptionStyle}"/>
      <TextBlock Text="{x:Bind Detail.NotesDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
     </StackPanel>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</ContentDialog>
